#!/usr/bin/env bash

set -euo pipefail

echo "== Zeitwerk =="
bin/rails zeitwerk:check

echo
echo "== RuboCop =="
bundle exec rubocop

echo
echo "== Dependency audit =="
bundle exec bundle-audit check

echo
echo "== Security scan =="
bundle exec brakeman --no-pager

echo
echo "== Tests and coverage =="
COVERAGE=true PARALLEL_WORKERS=1 bin/rails test

echo
echo "Zeitwerk, RuboCop, dépendances, sécurité et tests : validés."
echo "Couverture des lignes : seuil minimal de 85 % validé par SimpleCov."
echo "🐷✨ Tout est propre. Rubychon approuve !"
