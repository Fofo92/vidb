<div class="border rounded p-2 mb-2" role="status">
  <% if @removed_count %>
    <p class="mb-1">Copies mises à la corbeille : <%= @removed_count %>.</p>
  <% elsif @removals.empty? %>
    <p class="mb-0">Aucune copie présente sélectionnée.</p>
  <% end %>

  <% @removals.select { |result| result[:error] }.each do |result| %>
    <p class="text-danger mb-1"><%= File.basename(result[:asset].last_known_path) %> — <%= result[:error] %></p>
  <% end %>

  <% pending = @removed_count ? [] : @removals.select { |result| result[:confirmation] } %>
  <% if pending.any? %>
    <%= form_with url: remove_copies_library_inventory_path, data: { turbo_frame: 'inventory_duplicates' } do |form| %>
      <%= hidden_field_tag :q, @query %>
      <%= hidden_field_tag :page, @page %>
      <ul class="small mb-2">
        <% pending.each do |result| %>
          <% asset = result[:asset] %>
          <li>
            <%= File.basename(asset.last_known_path) %> · <%= asset.language_version&.short_name || '—' %> ·
            <%= asset.byte_size ? number_to_human_size(asset.byte_size) : '—' %>
            <%= hidden_field_tag "confirmations[#{asset.id}]", result[:confirmation] %>
          </li>
        <% end %>
      </ul>
      <%= link_to 'Annuler', library_inventory_path(q: @query, page: @page), class: 'btn btn-sm btn-outline-secondary',
                  data: { turbo_frame: 'inventory_duplicates' } %>
      <%= form.submit "Mettre à la corbeille (#{pending.size})", class: 'btn btn-sm btn-danger',
                      data: { turbo_submits_with: 'Mise à la corbeille…' } %>
    <% end %>
  <% end %>
</div>
