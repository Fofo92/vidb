<section class="container-fluid py-3">
  <h1 class="h3">Inventaire et doublons</h1>
  <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <%= form_with url: library_inventory_path, method: :get, class: 'd-flex gap-2' do |form| %>
      <%= form.text_field :q, value: @query, placeholder: 'Titre ou numéro de fiche', aria: { label: 'Titre ou numéro de fiche' }, class: 'form-control' %>
      <%= form.submit 'Rechercher', class: 'btn btn-outline-primary' %>
    <% end %>
    <%= button_to 'Actualiser l’inventaire', refresh_library_inventory_path, class: 'btn btn-outline-secondary' %>
  </div>
  <% if @snapshot %>
    <p class="small text-muted">Dernier inventaire : <%= @snapshot[:inventory_at] %>. Les changements récents peuvent attendre la prochaine passe.</p>
  <% else %>
    <p class="alert alert-warning">Aucun inventaire complet exploitable. Aucune absence n’est déduite.</p>
  <% end %>
  <h2 class="h5">Copies à examiner — <%= @issue_count %></h2>
  <p class="small">Un chemin occupé par un autre encodage ne confirme pas l’ancienne copie.
    Les renommages proposés nécessitent une vérification ; aucune fusion ni suppression automatique.</p>
  <% eligible_ids = @issues.filter_map { |row| row[:asset].id if row[:retirable] } %>
  <%= form_with url: new_copy_retirement_path, method: :get, id: 'missing-copy-selection', class: 'mb-2' do |form| %>
    <%= form.submit 'Retirer les anciennes références sélectionnées…', disabled: eligible_ids.empty?, class: 'btn btn-outline-secondary btn-sm' %>
    <span class="small text-muted"><% if eligible_ids.empty? %>
      Aucune référence retirable sur cette page.
    <% else %>
      Sélection sur cette page. Sauvegarde et confirmation avant retrait des anciennes références.
    <% end %></span>
  <% end %>
  <div class="table-responsive" data-controller="inventory-selection">
    <table class="table table-sm align-middle" data-inventory-issues>
      <thead><tr><th scope="col" class="text-center" style="width: 2rem">
        <input type="checkbox" <%= "disabled" if eligible_ids.empty? %>
               title="<%= eligible_ids.empty? ? "Aucune référence retirable sur cette page" : "Tout sélectionner sur cette page" %>"
               aria-label="Tout sélectionner sur cette page"
               data-inventory-selection-target="all" data-action="change->inventory-selection#toggle">
      </th><th>Œuvre</th><th>Chemin enregistré</th><th>Constat</th><th>Renommages possibles</th></tr></thead>
      <tbody>
        <% @issues.each do |row| %>
          <% asset = row[:asset] %>
          <tr>
            <td class="text-center">
              <% if eligible_ids.include?(asset.id) %>
                <%= check_box_tag 'video_asset_ids[]', asset.id, false, form: 'missing-copy-selection',
                                  data: { inventory_selection_target: "item", action: "change->inventory-selection#sync" },
                                  aria: { label: "Retirer l’ancienne référence #{asset.id} après sauvegarde" } %>
              <% end %>
            </td>
            <td><%= link_to "#{asset.record.complete_title} (n° #{asset.record_id})", record_path(asset.record) %></td>
            <td class="small text-break"><%= asset.last_known_path %></td>
            <td><%= { 'absent' => 'Chemin absent', 'changed' => 'Fichier remplacé ou modifié', 'unverified' => 'Mesures insuffisantes', 'outside' => 'Hors périmètre de l’inventaire' }.fetch(row[:status]) %>
              <% if row[:status] == 'changed' && asset.status_missing? && !row[:retirable] &&
                    asset.technical_details['copy_removal_pending'].blank? %>
                <%= link_to new_record_copy_relink_path(asset.record, video_asset_id: asset.id, path: asset.last_known_path),
                            class: 'btn btn-sm btn-outline-primary', title: 'Confirmer le fichier à ce chemin…',
                            aria: { label: "Confirmer le fichier de #{asset.record.complete_title}" } do %>
                  <i class="fa-solid fa-check" aria-hidden="true"></i>
                <% end %>
              <% end %>
            </td>
            <td class="small">
              <% row[:candidates].first(5).each do |entry| %>
                <div class="mb-1 text-break">
                  <%= link_to entry[:path], new_record_copy_relink_path(asset.record, video_asset_id: asset.id, path: entry[:path]) %>
                </div>
              <% end %>
              <% if row[:candidates].empty? %>—<% end %>
              <% if row[:candidates].size > 5 %><span>Plus de cinq possibilités : examen détaillé nécessaire.</span><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render 'duplicates' %>
</section>
