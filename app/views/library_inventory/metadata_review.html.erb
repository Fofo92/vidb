<section class="container py-3">
  <p><%= link_to '← Inventaire et doublons', library_inventory_path %></p>
  <h1 class="h3">Genres et pays des séries et collections</h1>
  <p class="small mb-2">Simule les écarts, puis ouvre une branche pour enregistrer un mode.
    Les valeurs propres des enfants restent enregistrées.</p>
  <%= form_with url: metadata_review_library_inventory_path, method: :get, class: 'row g-2 align-items-end mb-2' do |form| %>
    <div class="col-md">
      <%= form.label :q, 'Titre du parent ou numéro de fiche', class: 'form-label small mb-1' %>
      <%= form.search_field :q, value: @metadata_query, class: 'form-control form-control-sm' %>
    </div>
    <div class="col-md">
      <%= form.label :genres, 'Genres', class: 'form-label small mb-1' %>
      <%= form.select :genres, RecordMetadataValues::MODES.invert,
                      { selected: @metadata_filters[:genres] }, class: 'form-select form-select-sm' %>
    </div>
    <div class="col-md">
      <%= form.label :pays, 'Pays', class: 'form-label small mb-1' %>
      <%= form.select :pays, RecordMetadataValues::MODES.invert,
                      { selected: @metadata_filters[:pays] }, class: 'form-select form-select-sm' %>
    </div>
    <div class="col-auto"><%= form.submit 'Simuler', class: 'btn btn-primary btn-sm' %></div>
  <% end %>

  <p class="small mb-1"><strong><%= @metadata_changed %> fiche(s) changeraient</strong> avec ces choix, sur
    <%= @metadata_reviewed %> fiche(s) à examiner dans <%= @metadata_total %> branche(s).</p>
  <p class="small text-muted mb-2">Par défaut : écarts, règles actives et parents à qualifier. Recherche un titre pour voir aussi les branches alignées.</p>

  <% if @metadata_branch %>
    <% branch = @metadata_branch %>
    <h2 class="h5"><%= link_to branch[:root].complete_title, record_path(branch[:root]) %> · n° <%= branch[:root].id %></h2>
    <div class="table-responsive mb-2">
      <table class="table table-sm align-middle mb-0 small">
        <thead><tr><th>Champ</th><th>Valeur du parent</th><th>État</th><th>Action sur cette branche</th></tr></thead>
        <tbody>
          <% branch[:targets].each do |key, target| %>
            <% configured = target[:configured] %>
            <% label = key == :genders ? 'genres' : 'pays' %>
            <tr>
              <th scope="row"><%= label.capitalize %></th>
              <td><%= render 'metadata_review_targets', key: key, target: target %></td>
              <td><%= RecordMetadataValues::MODES.fetch(configured) %><%= ' · Suspendu' if configured == 'parent' && !target[:ready] %></td>
              <td>
                <%= form_with url: update_metadata_forcing_library_inventory_path, method: :patch,
                              class: 'd-flex gap-1 align-items-center' do |form| %>
                  <%= form.hidden_field :root_id, value: branch[:root].id, id: "metadata_root_#{key}" %>
                  <%= form.hidden_field :field, value: key, id: "metadata_field_#{key}" %>
                  <%= form.select :mode, RecordMetadataValues::MODES.invert,
                                  { selected: configured, disabled: (['parent'] unless target[:ready]) },
                                  id: "metadata_mode_#{key}", aria: { label: "Mode des #{label}" }, class: 'form-select form-select-sm' %>
                  <%= form.submit 'Enregistrer', class: 'btn btn-outline-primary btn-sm' %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="table-responsive">
      <table class="table table-sm align-middle small" data-metadata-review>
        <thead><tr><th>Fiche</th><th>Champ</th><th>Saisi sur la fiche</th><th>Affiché aujourd’hui</th><th>Après simulation</th></tr></thead>
        <tbody>
          <% @metadata_rows.each do |row| %>
            <% row[:fields].each do |key, field| %>
              <% next unless field[:review] %>
              <tr>
                <td><%= link_to row[:record].complete_title_with_parents, record_path(row[:record]) %> · n° <%= row[:record].id %></td>
                <td><%= key == :genders ? 'Genres' : 'Pays' %></td>
                <% attribute = RecordMetadataInheritanceReview::FIELDS.fetch(key) %>
                <td><%= field[:own].map(&attribute).join(', ').presence || '—' %></td>
                <td><%= field[:current].map(&attribute).join(', ').presence || '—' %></td>
                <td class="<%= 'fw-bold' if field[:changed] %>"><%= field[:proposed].map(&attribute).join(', ').presence || '—' %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @metadata_rows.empty? %><p>Aucun écart dans cette branche.</p><% end %>
    <p><%= link_to 'Toutes les branches', metadata_review_library_inventory_path(@metadata_filters.except(:q)) %></p>
  <% else %>
    <div class="table-responsive">
      <table class="table table-sm align-middle small">
        <thead><tr><th>Série ou collection</th><th>Genres</th><th>Pays</th><th>Règles actives</th><th>Fiches qui changeraient</th></tr></thead>
        <tbody>
          <% @metadata_groups.each do |branch| %>
            <% root = branch[:root] %>
            <tr>
              <td><%= link_to "#{root.complete_title} · n° #{root.id}",
                              metadata_review_library_inventory_path(@metadata_filters.merge(q: root.id)) %></td>
              <% branch[:targets].each do |key, target| %>
                <td><%= render 'metadata_review_targets', key: key, target: target %></td>
              <% end %>
              <td><%= branch[:targets].filter_map { |key, target| "#{key == :genders ? 'Genres' : 'Pays'} : #{RecordMetadataValues::MODES.fetch(target[:configured])}" unless target[:configured] == 'current' }.join(', ').presence || '—' %></td>
              <td><%= branch[:changed_count] %> / <%= branch[:children_count] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @metadata_groups.empty? %><p>Aucune branche à examiner pour cette recherche.</p><% end %>
  <% end %>
  <% if @metadata_page_count > 1 %>
    <nav class="d-flex gap-3" aria-label="Pages de la simulation">
      <% if @metadata_page > 1 %>
        <%= link_to 'Précédent', metadata_review_library_inventory_path(@metadata_filters.merge(page: @metadata_page - 1)) %>
      <% end %>
      <span>Page <%= @metadata_page %> sur <%= @metadata_page_count %></span>
      <% if @metadata_page < @metadata_page_count %>
        <%= link_to 'Suivant', metadata_review_library_inventory_path(@metadata_filters.merge(page: @metadata_page + 1)) %>
      <% end %>
    </nav>
  <% end %>
</section>
