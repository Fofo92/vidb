<h1>Programmations Kaffeine</h1>
<p><%= link_to "Retour aux sélections vidb", tv_recording_intents_path %></p>
<p class="text-body-secondary">Liste lue directement dans Kaffeine. Les programmations sans lien avec vidb restent gérées dans Kaffeine.</p>

<% if @kaffeine_unavailable %>
  <p class="alert alert-warning">Impossible de consulter Kaffeine pour le moment.</p>
<% elsif @schedules.empty? %>
  <p class="alert alert-info">Aucune programmation dans Kaffeine.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-sm align-middle" data-kaffeine-schedules-table>
      <thead>
        <tr>
          <th scope="col">Clé</th>
          <th scope="col">Chaîne</th>
          <th scope="col">Nom</th>
          <th scope="col">Début</th>
          <th scope="col">Durée</th>
          <th scope="col">Lien vidb</th>
        </tr>
      </thead>
      <tbody>
        <% @schedules.each do |schedule| %>
          <% link = @links_by_key[schedule.key] %>
          <tr data-kaffeine-schedule="<%= schedule.key %>">
            <td><%= schedule.key %></td>
            <td><%= schedule.channel %></td>
            <td><%= schedule.name %></td>
            <td class="text-nowrap"><%= l(schedule.starts_at.in_time_zone("Europe/Paris"), format: :long) %></td>
            <td><%= Time.at(schedule.duration_seconds).utc.strftime("%H:%M:%S") %></td>
            <td>
              <% if link&.matches?(schedule) %>
                Liée à vidb (intention <%= link.recording_intent_id %>)
              <% else %>
                Kaffeine uniquement
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
