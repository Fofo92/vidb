<div class="d-flex justify-content-between align-items-center">
  <h1>Supports</h1>
  <%= link_to new_medium_path, class: "btn btn-primary fa-xl" do %>
    <i class="fa-regular fa-square-plus"></i>
  <% end %>
</div>
<% if @media.empty? %>
  <h5>Liste vide</h5>
<% else %>
  <table class="table table-hover">
    <thead>
      <tr>
        <th scope="col">#</th>
        <th scope="col">Nom abrégé</th>
        <th scope="col">Nom complet</th>
      </tr>
    </thead>
    <tbody>
      <% @media.each do |medium| %>
        <tr>
          <td><%= medium.id %></td>
          <td><%= medium.short_name %></td>
          <td><%= medium.long_name %></td>
        <td class="text-center">
            <%= link_to edit_medium_path(medium) do %>
              <i class="fas fa-edit"></i>
            <% end %>
            <%= link_to medium, data: {turbo_method: :delete, turbo_confirm: "Êtes-vous sûr ?" } do %>
              <i class="fas fa-trash-alt"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>


