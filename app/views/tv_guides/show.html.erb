<h1>Programmes TV</h1>

<% if @guide_source %>
  <%= form_with(
    url: tv_guide_path,
    method: :get,
    data: {
      controller: "auto-submit",
      action: "change->auto-submit#submit"
    }
  ) do %>
 <%= hidden_field_tag :guide_source_id, @guide_source.id %>
    <div class="tv-guide-toolbar">
      <div class="tv-guide-toolbar-date">
        <%= label_tag(
          :date,
          "Journée",
          class: "form-label"
        ) %>
        <%= date_field_tag(
          :date,
          @date.iso8601,
          class: "form-control form-control-sm",
          autocomplete: "off"
        ) %>
      </div>

      <div class="tv-guide-toolbar-channels">
        <div class="form-check">
          <%= check_box_tag(
            :all_channels,
            "1",
            @show_all_channels,
            class: "form-check-input"
          ) %>
          <%= label_tag(
            :all_channels,
            "Toutes les chaînes",
            class: "form-check-label"
          ) %>
        </div>

        <%= link_to(
          "Gérer mes chaînes favorites",
          edit_tv_channel_preferences_path,
          class: "btn btn-sm btn-outline-secondary"
        ) %>
      </div>

      <div class="tv-guide-toolbar-scale">
        <span aria-hidden="true">Échelle</span>

        <div
          class="btn-group"
          role="group"
          aria-label="Échelle temporelle">
          <% [
            ["Compacte", 1],
            ["Lisible", 2],
            ["Détaillée", 4]
          ].each do |label, value| %>
            <% input_id = "zoom_#{value}" %>

            <%= radio_button_tag(
              :zoom,
              value,
              @minute_height == value,
              id: input_id,
              class: "btn-check"
            ) %>
            <%= label_tag(
              input_id,
              label,
              class: "btn btn-sm btn-outline-secondary"
            ) %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <section data-tv-guide-day="<%= @date.iso8601 %>">
    <% if @programmes_by_channel.empty? %>
      <p>Aucun programme disponible pour cette journée.</p>
    <% else %>
      <% reference_timeline = @timelines_by_channel.values.first %>
      <% projected_height = @timeline_projection.position_for(reference_timeline.duration_minutes) %>

      <div
        class="tv-guide-scroll"
        data-tv-guide-scroll
        data-controller="tv-guide-scroll tv-guide-information"
        data-action="
          submit->tv-guide-scroll#remember
          mouseover->tv-guide-information#open
          mouseout->tv-guide-information#close
          focusin->tv-guide-information#open
          focusout->tv-guide-information#close
          click->tv-guide-information#toggle
          keydown.esc->tv-guide-information#dismiss">
        <div
          class="tv-guide-grid"
          data-tv-guide-grid
          data-tv-guide-minute-height="<%= @minute_height %>"
          data-tv-guide-height-pixels="<%= projected_height %>"
          style="
            --tv-day-minutes:
              <%= reference_timeline.duration_minutes %>;
            --tv-minute-height: <%= @minute_height %>px;
            --tv-day-height: <%= projected_height %>px;
          ">
          <aside
            class="tv-guide-time-axis"
            data-tv-guide-time-axis>
            <div class="tv-guide-column-heading">Heure</div>

            <div class="tv-guide-time-axis-body">
              <% reference_timeline.ticks.each do |tick| %>
                <% tick_top =
                    @timeline_projection.position_for(tick.minute) %>
                <time
                  data-tv-guide-time-tick
                  data-tv-guide-minute="<%= tick.minute %>"
                  data-tv-guide-top-pixels="<%= tick_top %>"
                  style="
                    --tv-tick-minute: <%= tick.minute %>;
                    --tv-tick-top: <%= tick_top %>px;
                  ">
                  <%= tick.label %>
                </time>
              <% end %>
            </div>
          </aside>

          <% @timelines_by_channel.each do |guide_channel, timeline| %>
            <section
              class="tv-guide-channel"
              data-tv-guide-channel="<%= guide_channel.external_id %>"
              data-tv-guide-timeline
              data-tv-guide-duration-minutes="<%= timeline.duration_minutes %>">
              <h2 class="tv-guide-column-heading" aria-label="<%= guide_channel.channel.display_name %>">
                <% if (france_number = tv_france_channel_number(guide_channel.channel)) %>
                  <span class="badge text-bg-secondary">
                    <%= guide_channel.channel.logical_number %>
                  </span>
                  <span class="tv-guide-france-number tv-guide-france-number--<%= france_number %>"
                        aria-hidden="true" data-tv-guide-france-number>
                    <%= france_number %>
                  </span>
                  <span class="visually-hidden" data-tv-guide-channel-name>
                    <%= guide_channel.channel.display_name %>
                  </span>
                <% else %>
                  <span class="badge text-bg-secondary">
                    <%= guide_channel.channel.logical_number %>
                  </span>
                  <span class="tv-guide-channel-identity" data-controller="tv-channel-logo">
                    <% if (logo_url = tv_channel_logo_url(guide_channel.channel)) %>
                      <%= image_tag logo_url,
                                    alt: "",
                                    class: "tv-guide-channel-logo #{tv_channel_logo_class(guide_channel.channel)}",
                                    loading: "lazy",
                                    referrerpolicy: "no-referrer",
                                    data: {
                                      tv_channel_logo_target: "image",
                                      action: "load->tv-channel-logo#loaded error->tv-channel-logo#failed"
                                    } %>
                    <% end %>
                    <span data-tv-guide-channel-name data-tv-channel-logo-target="name">
                      <%= guide_channel.channel.display_name %>
                    </span>
                  </span>
                <% end %>
              </h2>
              <ol class="tv-guide-timeline">
                <% timeline.ticks.each do |tick| %>
                  <% tick_top = @timeline_projection.position_for(tick.minute) %>
                  <li
                    class="tv-guide-hour-line"
                    data-tv-guide-hour-line
                    data-tv-guide-minute="<%= tick.minute %>"
                    data-tv-guide-top-pixels="<%= tick_top %>"
                    aria-hidden="true"
                    role="presentation"
                    style="--tv-tick-top: <%= tick_top %>px;"></li>
                <% end %>

                <% timeline.items.each do |item| %>
                  <% programme = item.programme %>
                  <% recording_intent = programme.recording_intent %>
                  <% recording_selected = recording_intent&.status_selected? %>
                  <% top_pixels =
                      @timeline_projection.position_for(item.start_minute) %>
                  <% height_pixels =
                      @timeline_projection.height_between(
                        item.start_minute,
                        item.start_minute + item.duration_minutes
                      ) %>
                  <% single_line =
                      height_pixels == @minimum_programme_height %>
                  <li
                    class="
                      tv-guide-programme
                      <%= "tv-guide-programme--single-line" if single_line %>
                      <%= "tv-guide-programme--recording-selected" if recording_selected %>
                    "
                    data-tv-guide-programme="<%= programme.id %>"
                    data-tv-guide-recording-status="<%= recording_selected ? "selected" : "unselected" %>"
                    tabindex="0"
                    data-tv-guide-start-minute="<%= item.start_minute %>"
                    data-tv-guide-duration-minutes="<%= item.duration_minutes %>"
                    data-tv-guide-top-pixels="<%= top_pixels %>"
                    data-tv-guide-height-pixels="<%= height_pixels %>"
                    data-tv-guide-single-line="<%= single_line %>"
                    style="
                      --tv-start-minute: <%= item.start_minute %>;
                      --tv-duration-minutes: <%= item.duration_minutes %>;
                      --tv-top-pixels: <%= top_pixels %>px;
                      --tv-height-pixels: <%= height_pixels %>px;
                    ">
                    <div class="tv-guide-programme-times">
                      <time data-tv-guide-start>
                        <%= programme.starts_at
                                    .in_time_zone("Europe/Paris")
                                    .strftime("%H:%M") %>
                      </time>
                      –
                      <time data-tv-guide-end>
                        <%= programme.ends_at
                                    .in_time_zone("Europe/Paris")
                                    .strftime("%H:%M") %>
                      </time>
                    </div>

                    <strong data-tv-guide-title>
                      <%= tv_programme_label(programme) %>
                    </strong>

                    <% if (previous_intent = @previous_recordings[programme.id]) %>
                      <span class="tv-guide-previous-recording" data-tv-guide-previous-recording>
                        Déjà enregistré (vérifié)
                      </span>
                    <% end %>

                    <% if recording_selected %>
                      <% recording_url =
                          tv_recording_intent_path(recording_intent) %>
                      <% recording_method = :delete %>
                      <% recording_label =
                          "Annuler la sélection de #{tv_programme_label(programme)}" %>
                    <% else %>
                      <% recording_url = tv_recording_intents_path %>
                      <% recording_method = :post %>
                      <% recording_label =
                          if guide_channel.channel.kaffeine_name.present?
                            "Programmer #{tv_programme_label(programme)} dans Kaffeine"
                          else
                            "Sélectionner #{tv_programme_label(programme)} pour enregistrement"
                          end %>
                    <% end %>

                    <% if recording_selected %>
                      <% if (link = recording_intent.kaffeine_schedule_link) %>
                        <span
                          class="tv-guide-schedule-status tv-guide-schedule-status--confirmed"
                          data-tv-guide-schedule
                          aria-label="Programmée dans Kaffeine, numéro <%= link.kaffeine_key %>"
                          title="Programmée dans Kaffeine (n° <%= link.kaffeine_key %>)">
                          <%= link.kaffeine_key %>
                        </span>
                      <% elsif guide_channel.channel.kaffeine_name.present? %>
                        <%= form_with(
                          url: tv_recording_intent_schedule_path(recording_intent),
                          method: :post,
                          html: { class: "tv-guide-schedule-form" }
                        ) do %>
                          <%= hidden_field_tag :return_to, "guide" %>
                          <%= hidden_field_tag :date, @date.iso8601 %>
                          <%= hidden_field_tag :guide_source_id, @guide_source.id %>
                          <%= hidden_field_tag :zoom, @minute_height %>
                          <% if @show_all_channels %>
                            <%= hidden_field_tag :all_channels, "1" %>
                          <% end %>
                          <%= button_tag(
                            "Kaffeine",
                            type: "submit",
                            class: "tv-guide-schedule-button",
                            aria: { label: "Programmer dans Kaffeine" }
                          ) %>
                        <% end %>
                      <% else %>
                        <span class="tv-guide-schedule-status" data-tv-guide-schedule>
                          Chaîne non reliée à Kaffeine
                        </span>
                      <% end %>
                    <% end %>

                    <%= button_tag(
                      "i",
                      type: "button",
                      class: "tv-guide-information",
                      data: { tv_guide_information: true },
                      aria: {
                        label: "Informations sur #{tv_programme_label(programme)}",
                        expanded: false
                      }
                    ) %>

                    <div data-tv-guide-secondary>
                      <% if previous_intent %>
                        <div data-tv-guide-previous-recording-detail>
                          Fichier d’un précédent enregistrement vérifié dans vidb
                          (<%= previous_intent.programme_starts_at
                                              .in_time_zone("Europe/Paris")
                                              .strftime("%d/%m/%Y") %>).
                          Vous pouvez programmer cette rediffusion si vous le souhaitez.
                        </div>
                      <% end %>
                      <% if (original_title =
                          tv_programme_original_title(programme)) %>
                        <div data-tv-guide-original-title>
                          Titre original ou alternatif :
                          <%= original_title %>
                        </div>
                      <% end %>

                      <% if (category = tv_programme_category(programme)) %>
                        <div data-tv-guide-category>
                          <%= category %>
                        </div>
                      <% end %>

                      <% if (description =
                          tv_programme_description(programme)) %>
                        <p data-tv-guide-description>
                          <%= description %>
                        </p>
                      <% end %>
                    </div>

                    <%= form_with(
                      url: recording_url,
                      method: recording_method,
                      html: { class: "tv-guide-recording-form" }
                    ) do %>
                      <%= hidden_field_tag(
                        :broadcast_observation_id,
                        programme.id
                      ) %>
                      <%= hidden_field_tag :date, @date.iso8601 %>
                      <%= hidden_field_tag(
                        :guide_source_id,
                        @guide_source.id
                      ) %>
                      <%= hidden_field_tag :zoom, @minute_height %>
                      <% if @show_all_channels %>
                        <%= hidden_field_tag :all_channels, "1" %>
                      <% end %>

                      <%= button_tag(
                        type: "submit",
                        class: "tv-guide-recording-toggle",
                        data: { tv_guide_recording_toggle: true },
                        aria: { label: recording_label }
                      ) do %>
                        <span class="visually-hidden">
                          <%= recording_label %>
                        </span>
                      <% end %>
                    <% end %>
                  </li>
                <% end %>
              </ol>
            </section>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
<% else %>
  <p class="alert alert-warning" data-tv-guide-unavailable>
    Aucune source de programmes TV n’est actuellement disponible.
  </p>
<% end %>
