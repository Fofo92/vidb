<% value = record.display_range_of_years %>
<% if value.present? %>
  <span data-record-year="<%= record.id %>"><%= value %></span>
  <% if local_assigns.fetch(:detail, false) %>
    <small class="text-muted" title="<%= record.year_basis_description %>"><%= record.year_basis_label %></small>
  <% end %>
<% else %>
  <span title="Année inconnue">—</span>
<% end %>
