<% content_for :head do %>
  <%= stylesheet_link_tag "record_show", "data-turbo-track": "reload" %>
<% end %>
<% copies = record_copy_summary(@record) %>
<% metadata = record_metadata_values(@record) %>
<% genres = metadata.genders(@record).map(&:name).join(", ") %>
<% countries = metadata.countries(@record).map(&:long_name).sort_by(&:parameterize).join(", ") %>
<% poster = RecordPosters::Display.call(@record) %>
<% placement_status = @record.hierarchy_placement_status %>
<% display_year = @record.display_range_of_years %>
<div class="record-show" data-controller="record-states record-live" data-record-live-root
     data-record-live-url-value="<%= record_live_path(@record) %>"
     data-record-live-version-value="<%= @record_live_version %>" data-record-states-url-value="<%= record_states_path(@record) %>">
  <div class="small" role="status" aria-live="polite" data-record-states-target="message"></div>

  <span class="record-show-sr-only" role="status" aria-live="polite" data-record-live-target="status"></span>

  <section class="record-show-overview" data-record-overview aria-labelledby="record-title">
    <div class="record-show-artwork" data-record-live-region="artwork">
      <% if poster %>
        <%= render "records/poster", record: @record, poster: poster, large: true %>
      <% else %>
        <div class="record-show-poster-placeholder" data-record-poster-placeholder role="img" aria-label="Pochette indisponible">
          <i class="fa-solid fa-film" aria-hidden="true"></i>
          <span>Pochette indisponible</span>
        </div>
      <% end %>
      <%= render "records/poster_controls", record: @record %>
    </div>
    <div class="record-show-content">
      <section class="record-show-editorial" data-record-information data-record-live-region="information">
        <header class="record-show-heading">
          <nav class="record-show-actions" aria-label="Actions sur cette fiche">
            <%= link_to "Filtrer cet arbre", records_path(filters: { tree_id: @record.id }), class: "btn btn-outline-secondary btn-sm" %>
            <%= link_to "Déplacer", edit_record_hierarchy_placement_path(@record), class: "btn btn-outline-secondary btn-sm" %>
            <%= link_to edit_record_path(@record), class: "btn btn-outline-primary btn-sm", title: "Modifier la fiche", aria: { label: "Modifier la fiche" } do %>
              <i class="fa-regular fa-edit" aria-hidden="true"></i>
            <% end %>
            <%= link_to new_record_path, class: "btn btn-outline-primary btn-sm", title: "Nouvelle fiche", aria: { label: "Nouvelle fiche" } do %>
              <i class="fa-regular fa-square-plus" aria-hidden="true"></i>
            <% end %>
          </nav>
          <div class="record-show-context">
            <nav class="record-show-breadcrumbs" aria-label="Arborescence vidb" data-record-breadcrumbs>
              <ol>
                <% record_show_breadcrumbs(@record, genres: genres).each do |crumb| %>
                  <li>
                    <% if crumb[:record] && crumb[:record] != @record %>
                      <%= link_to crumb[:label], record_path(crumb[:record]) %>
                    <% else %>
                      <%= tag.span crumb[:label], aria: { current: ('page' if crumb[:record] == @record) } %>
                    <% end %>
                  </li>
                <% end %>
              </ol>
            </nav>
            <span class="record-show-nature record-show-nature--<%= placement_status %>"
                  data-record-kind data-hierarchy-placement-status="<%= placement_status %>"
                  title="Placement : <%= hierarchy_placement_label(placement_status) %>"
                  aria-label="<%= record_kind_label(@record.record_kind) %> — placement <%= hierarchy_placement_label(placement_status) %>">
              <%= record_kind_label(@record.record_kind) %>
            </span>
          </div>
          <h1 id="record-title">
            <span data-record-main-title><%= @record.french_title.presence || @record.original_title %></span>
            <% if display_year.present? %>
              <span class="record-show-year">(<span data-record-year="<%= @record.id %>" title="<%= @record.year_basis_description %>"><%= display_year %></span>)</span>
            <% end %>
          </h1>
          <% if @record.original_title.present? && @record.french_title.present? %>
            <p class="record-show-original-title" data-record-original-title><%= @record.original_title %></p>
          <% end %>
        </header>

        <dl class="record-show-facts">
          <% if genres.present? %>
            <div><dt>Genres</dt><dd><%= genres %></dd></div>
          <% end %>
          <div>
            <dt>Durée</dt>
            <dd data-copy-duration="<%= @record.id %>" title="Durée mesurée des copies présentes quand elle est connue ; sinon, durée renseignée. Les copies alternatives ne sont pas additionnées."><%= copies.summary_duration %></dd>
          </div>
          <% if countries.present? %>
            <div><dt>Pays de production</dt><dd><%= countries %></dd></div>
          <% end %>
        </dl>

        <% if @record.abstract.present? %>
          <% if @record.record_kind_season? %>
            <details class="record-show-synopsis" data-season-presentation>
              <summary>Présentation de cette saison</summary>
              <p class="record-show-abstract"><%= @record.abstract %></p>
            </details>
          <% else %>
            <div class="record-show-synopsis" aria-label="Abrégé">
              <h2 class="record-show-sr-only">Abrégé</h2>
              <p class="record-show-abstract"><%= @record.abstract %></p>
            </div>
          <% end %>
        <% end %>

      </section>

      <section class="record-show-viewing" data-record-viewing data-record-live-region="viewing" aria-labelledby="record-viewing-title">
        <h2 id="record-viewing-title">Visionnage et copies</h2>
        <%= render "records/dvd_holdings", record: @record %>
        <div class="record-show-viewing-summary">
          <div data-record-states-target="summary">
            <%= render "records/state_summary", record: @record %>
          </div>
          <dl class="record-show-copy-facts">
            <div>
              <dt>Supports</dt>
              <dd data-copy-supports="<%= @record.id %>"><%= copies.summary_supports %></dd>
            </div>
            <div>
              <dt>Versions</dt>
              <dd data-copy-languages="<%= @record.id %>"><%= copies.summary_languages %></dd>
            </div>
          </dl>
        </div>
        <% if @record.video_assets.any? %>
          <details class="record-show-copy-details" data-record-copy-details>
            <summary>Détails des copies</summary>
            <%= render "records/video_assets", record: @record %>
          </details>
        <% elsif @record.has_children? %>
          <p class="record-show-copy-note">Les copies sont détaillées dans les fiches enfants.</p>
        <% else %>
          <p class="record-show-copy-note">Aucune copie de fichier confirmée sur cette fiche.</p>
        <% end %>
      </section>
      <div class="record-show-secondary" data-record-live-region="provenance">
        <%= render "records/year_provenance", record: @record %>
        <%= render "records/catalogue_partition", record: @record %>

      </div>
    </div>
  </section>
<div data-record-live-region="children">
<div class="d-flex flex-row justify-content-between align-items-center">
  <%= link_to "Retour à la liste d'enregistrements", records_path, class: "btn btn-primary btn-sm" %>
  <% if @record.allows_new_hierarchy_children? %>
    <%= link_to new_child_record_path(@record),
      class: "btn btn-primary btn-sm fa-xl" do %>
      <i class="fa-regular fa-square-plus"></i>
    <% end %>
  <% end %>
</div>
<% if @record.has_children? %>
    <p>
      <%= link_to(
        "Qualifier les enfants",
        edit_record_child_qualification_path(@record),
        class: "btn btn-outline-primary btn-sm"
      ) %>
    </p>

  <%# child_type = @record.children.first.type_list || "enregistrement" %>
  <% record_count = @record.children.count - @record.children.where(is_recorded: [nil, ""]).count %>
  <% vizualised_count = @record.children.count - @record.children.where(is_seen: [nil, ""]).count %>
  <table class="table table-striped table-sm">
    <thead>
      <tr>
        <th>#</th>
        <th>Rang</th>
        <th>Titre</th>
        <th>Année</th>
        <th>Durée</th>
        <th>Genre</th>
        <th>Pays</th>
        <th>Version</th>
        <th>Support</th>
        <%= render "records/state_columns", record: @record, header: true %>
        <th><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody data-record-states-target="rows">
      <%= render "records/child_rows", record: @record %>
    </tbody>
  </table>
<% end %>

</div>

</div>
