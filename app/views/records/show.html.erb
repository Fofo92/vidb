
<div class="d-flex flex-row justify-content-between align-items-center">
  <h4>
    <%= link_to @record.complete_title_with_parents, (@record.has_parent? ? record_path(@record.parent) : nil) %>
  </h4>
  <div>
    <%= link_to edit_record_path(@record), class: "btn btn-primary btn-sm fa-xl" do %>
          <i class="fa-regular fa-edit"></i>
    <% end %>
    <%= link_to new_record_path, class: "btn btn-primary btn-sm fa-xl" do %>
      <i class="fa-regular fa-square-plus"></i>
    <% end %>
  </div>
</div>
<p>
  <strong>Type d'enregistrement : </strong>néant<%#= (@record.type_list.nil? ? "nil" : @record.type_list) %>
  <strong>, genre : </strong><%= @record.genders.order(:name).map(&:name).join(", ") || "néant" %>
  <strong>, durée : </strong><%= @record.formatted_total_length %>
</p>
<p>
  <strong>Année : </strong><%= @record.display_range_of_years %>,
  <strong>pays : </strong><%= @record.countries.order(:long_name).map(&:long_name).join(", ") %>
  <strong>, disponible sur : </strong><%= @record.media.map(&:long_name).join(", ") || "Néant" %>
  <strong>, version linguistique : </strong><%= @record.language_version.nil? ? "n/a" : @record.language_version.long_name %>
</p>
<% if @record.has_parent? && @record.has_children? %>
  <strong>Nombre d'enregistrements :</strong>
  <ul>
    <li>enregistrés : <%= @record.number_of_recorded_children || 'n/a' %>/<%= @record.descendants.count %></li>
    <li>visionnés : <%= @record.number_of_seen_children || 'n/a' %>/<%= @record.descendants.count %></li>
    <li>disponibles : <%= @record.number_of_available_children || 'n/a' %>/<%= @record.descendants.count %></li>
  </ul>
<% end %>
<p><strong>Abrégé : </strong><%= @record.abstract %></p>
<div class="d-flex flex-row justify-content-between align-items-center">
<%= link_to "Retour à la liste d'enregistrements", records_path, class: "btn btn-primary btn-sm" %>
  <%= link_to new_child_record_path, class: "btn btn-primary btn-sm fa-xl" do %>
    <i class="fa-regular fa-square-plus"></i>
  <% end %>
</div>
<% if @record.has_children? %>
  <%# child_type = @record.children.first.type_list || "enregistrement" %>
  <% record_count = @record.children.count - @record.children.where(is_recorded: [nil, ""]).count %>
  <% vizualised_count = @record.children.count - @record.children.where(is_seen: [nil, ""]).count %>
  <table class="table table-striped table-sm">
    <thead>
      <tr>
        <th>#</th>
        <th>Rang</th>
        <th>Titre</th>
        <th>Année</th>
        <th>Durée</th>
        <th>Genre</td>
        <td>Pays</td>
        <th>Version</th>
        <th>Support</th>
        <th>État</th>
      </tr>
    </thead>
    <tbody>
      <% @record.children.order(:rank).each do |record| %>
        <tr>
          <td><%= record.id %></td>
          <td><%= record.rank %></td>
          <td>
            <%= link_to record_path(record) do %>
              <%= record.french_title.blank? ? "" : record.french_title %>
              <%= record.original_title.blank? ? "" : " (#{record.original_title})" %>
            <% end %>
          </td>
          <td><%= record.year || record.display_range_of_years %></td>
          <td><%= record.length_in_mn.nil? ? record.formatted_total_length : record.formatted_length(record.length_in_mn) %></td>
          <td><%= record.genders.order(:name).map(&:name).join(", ") || "néant" %></td>
          <td><%= @record.countries.order(:long_name).map(&:flag).join("") %></td>
          <td><%= record.language_version.nil? ? "n/a" : record.language_version.short_name %></td>
          <td><%= record.media.map(&:short_name).join(", ") %></td>
          <td>
            <% if record.is_recorded? %>
            <i class="fas fa-record-vinyl" style="color:green;"></i>
          <% else %>
            <i class="fas fa-record-vinyl" style="color:red;"></i>
          <% end %>
          <% if record.is_seen? %>
            <i class="fas fa-eye" style="color:green;"></i>
          <% else %>
            <i class="fas fa-eye-slash" style="color:red;"></i>
          <% end %>
          <% if record.is_available? %>
            <i class="fas fa-folder-plus" style="color:green;"></i>
          <% else %>
            <i class="fas fa-folder-minus" style="color:red;"></i>
          <% end %>
          <% if record.is_checked? %>
            <i class="fas fa-check" style="color:green;"></i>
          <% else %>
            <i class="fas fa-xmark" style="color:red;"></i>
          <% end %>
          </td>
          <td>
            <%= link_to edit_record_path(record) do %>
              <i class="fas fa-edit"></i>
            <% end %>
          <%= link_to record_path(record),
						data: {
              turbo_method: :delete,
              turbo_confirm: "Êtes-vous sûr ?"
              } do %>
            	<i class="fas fa-trash-alt"></i>
          <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

