<div data-controller="record-states" data-record-states-url-value="<%= record_states_path(@record) %>">
  <div class="small" role="status" aria-live="polite" data-record-states-target="message"></div>

<div class="d-flex flex-row justify-content-between align-items-center">
  <h4>
    <%= link_to @record.complete_title_with_parents, (@record.has_parent? ? record_path(@record.parent) : nil) %>
  </h4>
  <div>
    <%= link_to(
      "Déplacer",
      edit_record_hierarchy_placement_path(@record),
      class: "btn btn-outline-primary btn-sm"
    ) %>

    <%= link_to edit_record_path(@record), class: "btn btn-primary btn-sm fa-xl" do %>
          <i class="fa-regular fa-edit"></i>
    <% end %>

    <%= link_to new_record_path, class: "btn btn-primary btn-sm fa-xl" do %>
      <i class="fa-regular fa-square-plus"></i>
    <% end %>
  </div>
</div>
<% copies = record_copy_summary(@record) %>
<p>
  <span data-record-kind>
    <strong>Nature du contenu : </strong><%= record_kind_label(@record.record_kind) %>
  </span>
  <% placement_status = @record.hierarchy_placement_status %>
  <span
    data-hierarchy-placement-status="<%= placement_status %>"
    title="Diagnostic du placement de cette fiche par rapport à son parent immédiat ou à la racine ; il ne porte pas sur ses descendants"
  >
    <strong>, placement de cette fiche : </strong>
    <span class="badge <%= hierarchy_placement_badge_class(placement_status) %>">
      <%= hierarchy_placement_label(placement_status) %>
    </span>
  </span>
  <strong>, genre : </strong><%= @record.genders.order(:name).map(&:name).join(", ") || "néant" %>
  <strong>, durée : </strong><span data-copy-duration="<%= @record.id %>" title="Durée des copies présentes, mesurée et arrondie ; valeur catalogue sinon"><%= copies.duration %></span>
</p>
<p>
  <strong>Année : </strong><%= render "records/year", record: @record %>,
  <strong>pays : </strong><%= @record.countries.order(:long_name).map(&:long_name).join(", ") %>
  <strong>, disponible sur : </strong><span data-copy-supports="<%= @record.id %>"><%= copies.supports %></span>
  <strong>, version linguistique : </strong><span data-copy-languages="<%= @record.id %>"><%= copies.languages %></span>
</p>
<div data-record-states-target="summary">
  <%= render "state_summary", record: @record %>
</div>
<%= render "video_assets", record: @record %>
<%= render "records/year_provenance", record: @record %>
<p><strong>Abrégé : </strong><%= @record.abstract %></p>
<div class="d-flex flex-row justify-content-between align-items-center">
  <%= link_to "Retour à la liste d'enregistrements", records_path, class: "btn btn-primary btn-sm" %>
  <% if @record.allows_new_hierarchy_children? %>
    <%= link_to new_child_record_path,
      class: "btn btn-primary btn-sm fa-xl" do %>
      <i class="fa-regular fa-square-plus"></i>
    <% end %>
  <% end %>
</div>
<% if @record.has_children? %>
  <% if @record.allowed_record_kinds_for_child_qualification.any? %>
    <p>
      <%= link_to(
        "Qualifier les enfants",
        edit_record_child_qualification_path(@record),
        class: "btn btn-outline-primary btn-sm"
      ) %>
    </p>
  <% end %>

  <%# child_type = @record.children.first.type_list || "enregistrement" %>
  <% record_count = @record.children.count - @record.children.where(is_recorded: [nil, ""]).count %>
  <% vizualised_count = @record.children.count - @record.children.where(is_seen: [nil, ""]).count %>
  <table class="table table-striped table-sm">
    <thead>
      <tr>
        <th>#</th>
        <th>Rang</th>
        <th>Titre</th>
        <th>Année</th>
        <th>Durée</th>
        <th>Genre</th>
        <th>Pays</th>
        <th>Version</th>
        <th>Support</th>
        <%= render "state_columns", record: @record, header: true %>
        <th><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody data-record-states-target="rows">
      <%= render "child_rows", record: @record %>
    </tbody>
  </table>
<% end %>


</div>
