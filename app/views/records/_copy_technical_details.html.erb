<% storage = asset.technical_details.fetch("storage", {}) %>
<% if storage.present? %>
  <p class="mb-1">Stockage : <%= storage["target"] %> (<%= storage["fstype"] %>)
    — volume <%= storage["uuid"] %></p>
<% end %>
<% streams = asset.technical_details.dig("language_qualification", "checked_streams") || asset.technical_details.fetch("streams", []) %>
<% if streams.any? %>
  <ul class="mb-1">
    <% streams.each do |stream| %>
      <li>
        <%= stream["codec_type"] %> — <%= stream["codec_name"] %>
        <% if %w[audio subtitle].include?(stream["codec_type"]) %>
          <% language = stream.fetch("tags", {})["language"] %>
          — langue déclarée : <%= language.present? && language != "und" ? language : "non renseignée" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
