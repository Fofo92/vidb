<% if record.video_assets.any? %>
  <p><strong>Copies confirmées :</strong></p>
  <ul data-confirmed-video-assets>
    <% record.video_assets.includes(:medium, :language_version).order(:id).each do |asset| %>
      <li>
        <%= asset.status_present? ? "Présente" : "Supprimée" %> —
        <% if asset.broadcast_part_number %>
          <strong>Partie <%= asset.broadcast_part_number %>/<%= record.broadcast_part_count %></strong> —
        <% end %>
        <span title="Durée mesurée du fichier, arrondie à la minute">
          <%= asset.duration_minutes ? VideoAssets::DisplaySummary.format_minutes(asset.duration_minutes) : "durée inconnue" %>
        </span>
        — <%= asset.medium&.short_name || "support non renseigné" %>
        — <%= asset.language_version&.short_name || "version linguistique non confirmée pour cette copie" %>
        — <%= asset.last_known_path %>
        <% if asset.technical_details.present? %>
          <details>
            <summary>Détails techniques et provenance</summary>
            <% storage = asset.technical_details.fetch("storage", {}) %>
            <p>Stockage : <%= storage["target"] %> (<%= storage["fstype"] %>)
              — volume <%= storage["uuid"] %></p>
            <ul>
              <% asset.technical_details.fetch("streams", []).each do |stream| %>
                <li>
                  <%= stream["codec_type"] %> — <%= stream["codec_name"] %>
                  <% if %w[audio subtitle].include?(stream["codec_type"]) %>
                    <% language = stream.fetch("tags", {})["language"] %>
                    — langue déclarée : <%= language.present? && language != "und" ? language : "non renseignée" %>
                  <% end %>
                </li>
              <% end %>
            </ul>
            <%= render "records/copy_provenance", asset: asset %>
          </details>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
