<%= simple_form_for(@record) do |f| %>
  <% if @dvd_ean %>
    <%= hidden_field_tag :dvd_ean, @dvd_ean %>
    <p>Édition DVD à rattacher après création · <%= @dvd_ean %></p>
    <p>
      Renseigne le titre de l’œuvre, son titre original s’il diffère, sa nature (film, série ou collection)
      et son année de première diffusion ou de sortie. L’année de publication du DVD concerne l’édition.
    </p>
  <% end %>
  <div class="d-flex flex-row justify-content-between align-items-center">
    <%= f.input :french_title, input_html: { :size => 40 }, label: "Titre français" %>
    <%= f.input :original_title, input_html: { size: 40 }, label: "Titre original"  %>
    <% if @record.state_container? %>
      <p>Années des épisodes : <%= render "records/year", record: @record %></p>
    <% else %>
    <%= f.input :year, input_html: { maxlength: 4, size: 4}, label:"Année" %>
    <small class="text-muted" title="<%= @record.year_basis_description %>"><%= @record.year_basis_label %></small>
    <% end %>
    <%= f.input :record_kind,
            collection: record_kind_options(@record),
            include_blank: false,
            label: "Nature du contenu" %>
  </div>

  <div class="d-flex flex-row justify-content-between align-items-center">
    <%= f.input :rank, input_html: { maxlength: 4, size: 4}, label: "Rang" %>
    <%= render "records/duration_fields", record: @record, form: f %>
    <%= f.association :genders,
                      collection: Gender.all.order(:name).collect { |g| [g.name, g.id] },
                      input_html: { multiple: true, size: 5, class: 'w-100' },
											include_hidden: @metadata_forcing_parent == true, label: "Genre cinématographique",
                      include_blank: true %>
    <%= f.association :countries,
                collection: Country.all.order(:long_name).collect { |c| [c.long_name, c.id] },
                input_html: { multiple: true, size: 5, class: 'w-100' }, input_blank: false,
								include_hidden: @metadata_forcing_parent == true, label: "Pays de production", include_blank: true %>
    <%= f.association :language_version,
                collection: LanguageVersion.all,
                required: true,
                input_html: { multiple: false, size: 5, class: 'w-75', selected: 1 },
                include_blank: false,
                label: "Version linguistique",
                value_method: :id,
                label_method: :short_name %>
    <% if @record.parent %>
      <div class="record_parent_id" data-record-parent>
        <strong>Parent :</strong>
        <%= link_to(
          @record.parent.complete_title,
          record_path(@record.parent)
        ) %>

        <% @record.errors[:parent_id].each do |message| %>
          <div class="invalid-feedback d-block">
            <%= message %>
          </div>
        <% end %>
      </div>

      <%= f.hidden_field :parent_id if @record.new_record? %>
    <% end %>
  </div>

  <div class="d-flex flex-row justify-content-between align-items-center">
    <div class="d-flex flex-row justify-content-between align-items-center border px-2 py-1">
      <% if record_present_copies?(@record) %>
        <div data-record-copy-supports>
          <strong>Support(s) :</strong> <%= record_copy_summary(@record).summary_supports %>
          <small class="d-block text-muted">Selon les copies présentes.</small>
        </div>
      <% else %>
        <%= f.input :medium_ids,
          collection: Medium.all.collect { |m| [m.long_name, m.id]},
          include_blank: false, as: :check_boxes, label: "Support(s)"
        %>
      <% end %>
    </div>

    <div class="d-flex flex-row justify-content-between align-items-center">
      <div class="col align-self-start">
        <hd>État</hd>
        <% if @record.state_container? %>
          <p>États calculés à partir des épisodes et vidéos feuilles.</p>
          <%= render "state_summary", record: @record %>
        <% else %>
        <%= f.input :is_recorded, class: "padding=1px", label: "Enregistré" %>
        <%= f.input :is_seen, label: "Visionné" %>
        <%= f.input :is_available, label: "Disponible" %>
        <% end %>
      </div>
    </div>

    <div class="d-flex flex-row justify-content-between align-items-center">
    </div>
  </div>

  <div>
    <% if @record.record_kind_season? %>
      <details data-season-presentation>
        <summary>Présentation de cette saison (facultative)</summary>
        <p class="small text-muted">Réserve ce texte aux particularités de cette saison.
          La présentation générale appartient à la série ; les résumés aux épisodes.
          Genres et pays peuvent être hérités de la série.</p>
        <%= f.input :abstract, input_html: { rows: 5, cols: 105 }, label: "Présentation de cette saison" %>
      </details>
    <% else %>
    <%= f.input :abstract, width: 100 , input_html: { rows: 5, cols: 105 }, label: "Résumé" %>
    <% end %>
    <small class="text-muted" data-record-abstract-protection>
      Les sources externes ne remplaceront pas un résumé saisi, corrigé ou supprimé manuellement.
      Pour accepter un texte de remplacement, modifiez le résumé ici puis sauvegardez.
    </small>
  </div>

  <% if @metadata_forcing_parent %>
    <fieldset class="border rounded p-2 mb-2 small">
      <legend class="float-none w-auto px-1 mb-0 h6">Métadonnées communes aux enfants</legend>
      <div class="d-flex flex-wrap gap-3">
        <%= f.input :descendant_genre_mode, collection: RecordMetadataValues::MODES.invert, include_blank: false, label: 'Genres des enfants' %>
        <%= f.input :descendant_country_mode, collection: RecordMetadataValues::MODES.invert, include_blank: false, label: 'Pays des enfants' %>
      </div>
      <p class="mb-0 text-muted">Le mode choisi s’applique dès la sauvegarde. Les valeurs propres des enfants restent enregistrées.</p>
    </fieldset>
  <% end %>
  <%= f.button :submit, "Sauvegarder l'enregistrement", class: "btn btn-primary" %>
<% end %>
