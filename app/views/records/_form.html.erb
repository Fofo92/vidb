<%= simple_form_for(@record) do |f| %>
  <div class="d-flex flex-row justify-content-between align-items-center">
    <%= f.input :french_title, input_html: { :size => 40 }, label: "Titre français" %>
    <%= f.input :original_title, input_html: { size: 40 }, label: "Titre original"  %>
    <%= f.input :year, input_html: { maxlength: 4, size: 4}, label:"Année de production" %>
  </div>

  <div class="d-flex flex-row justify-content-between align-items-center">
    <%= f.input :rank, input_html: { maxlength: 4, size: 4}, label: "Rang" %>
    <%= f.input :length_in_mn, input_html: { maxlength: 4, size: 4}, label: "Durée (mn)" %>
    <%= f.association :genders,
                      collection: Gender.all.order(:name).collect { |g| [g.name, g.id] },
                      input_html: { multiple: true, size: 5, class: 'w-100' },
											include_hidden: false, label: "Genre cinématographique",
                      include_blank: true %>
    <%= f.association :countries,
                collection: Country.all.order(:long_name).collect { |c| [c.long_name, c.id] },
                input_html: { multiple: true, size: 5, class: 'w-100' }, input_blank: false,
								include_hidden: false, label: "Pays de production", include_blank: true
  %>
    <%= f.association :language_version,
                collection: LanguageVersion.all,
                required: true,
                input_html: { multiple: false, size: 5, class: 'w-75', selected: 1 },
                include_blank: false,
                label: "Version linguistique",
                value_method: :id,
                label_method: :short_name
    %>
    <%= f.input :parent_id, input_html: {size: 4} %>
  </div>

  <div class="d-flex flex-row justify-content-between align-items-center">
    <div class="d-flex flex-row justify-content-between align-items-center border px-2 py-1">
      <%= f.input :medium_ids,
        collection: Medium.all.collect { |m| [m.long_name, m.id]},
        include_blank: false, as: :check_boxes, label: "Support(s)"
      %>
    </div>

    <div class="d-flex flex-row justify-content-between align-items-center">
      <div class="col align-self-start">
        <hd>État</hd>
        <%= f.input :is_recorded, class: "padding=1px", label: "Enregistré" %>
        <%= f.input :is_seen, label: "Visionné" %>
        <%= f.input :is_available, label: "Disponible" %>
        <%= f.input :is_checked, label: "Vérifié" %>
      </div>
    </div>

    <div class="d-flex flex-row justify-content-between align-items-center">
    </div>
  </div>

  <div class="d-flex flex-row justify-content-between align-items-center">
    <%= f.input :abstract, width: 100 , input_html: { rows: 5, cols: 105 }, label: "Résumé" %>
  </div>

  <%= f.button :submit, "Sauvegarder l'enregistrement", class: "btn btn-primary" %>
<% end %>
