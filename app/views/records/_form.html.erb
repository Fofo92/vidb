<%= simple_form_for(@record) do |f| %>
  <div class="d-flex flex-row justify-content-between align-items-center">
    <%= f.input :french_title, input_html: { :size => 40 } %>
    <%= f.input :original_title, input_html: { size: 40 }  %>
  </div>

  <div class="d-flex flex-row justify-content-between align-items-center">
    <%= f.input :year, input_html: { maxlength: 4, size: 4} %>
    <%= f.input :rank, input_html: { maxlength: 4, size: 2} %>
    <%= f.input :length_in_mn, input_html: { maxlength: 4, size: 3} %>
    <%= f.input :language_version_id,
      collection: LanguageVersion.all.collect { |lv| [lv.short_name, lv.id]},
      include_blank: false,
      label: "Version linguistique",
      input_html: {value: f.object.language_version_id || 1}
    %>
    <%#= f.input :parent_id %>
  </div>

  <div class="d-flex flex-row justify-content-between align-items-center">
    <div class="d-flex flex-row justify-content-between align-items-center border px-2 py-1">
      <%= f.input :medium_ids,
        collection: Medium.all.collect { |m| [m.long_name, m.id]},
        include_blank: false, as: :check_boxes, label: "Support(s)"
      %>
    </div>

    <div class="d-flex flex-row justify-content-between align-items-center">
      <div class="col align-self-start">
        <hd>État</hd>
        <%= f.input :is_recorded, class: "padding=1px" %>
        <%= f.input :is_seen %>
        <%= f.input :is_available %>
        <%= f.input :is_checked %>
      </div>
    </div>

    <div class="d-flex flex-row justify-content-between align-items-center">
    </div>
  </div>

  <div class="d-flex flex-row justify-content-between align-items-center">
    <%= f.input :abstract, width: 100 , input_html: { rows: 5, cols: 105 } %>
  </div>

  <%= f.button :submit, "Sauvegarder l'enregistrement", class: "btn btn-primary" %>
<% end %>
