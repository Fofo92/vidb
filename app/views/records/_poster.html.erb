<% poster = RecordPosters::Display.call(record) %>
<% if poster %>
  <figure class="float-start me-3 mb-2" data-record-poster>
    <%= image_tag record_poster_path(record), alt: "Pochette : #{record.complete_title}",
                  width: 120, style: "max-width: 100%; height: auto; max-height: 180px; object-fit: contain;",
                  decoding: "async" %>
    <% if poster.source["kind"] == "tmdb" %>
      <figcaption class="small text-muted">
        Image : <%= link_to "TMDB", "https://www.themoviedb.org/", rel: "noopener noreferrer" %>
      </figcaption>
    <% end %>
  </figure>
<% end %>
