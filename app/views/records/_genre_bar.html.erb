<nav class="record-genre-bar" aria-label="Filtrer par genre">
  <strong class="small">Genres</strong>
  <div class="record-genre-buttons">
    <% selected = record_filter_value(:gender_id).to_s %>
    <%= link_to record_genre_filter_path(nil),
                class: "btn btn-sm #{selected.blank? ? 'btn-primary' : 'btn-outline-secondary'}",
                title: 'Tous les genres', data: { genre_filter: 'all', turbo: true },
                aria: { current: selected.blank? ? 'true' : nil, label: 'Tous les genres' } do %>
      <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
    <% end %>
    <% record_filter_options(:gender_id).each do |name, id| %>
      <% active = selected == id.to_s %>
      <%= link_to record_genre_filter_path(id),
                  class: "btn btn-sm #{active ? 'btn-primary' : 'btn-outline-secondary'}",
                  title: name, data: { genre_filter: id, turbo: true },
                  aria: { current: active ? 'true' : nil, label: name } do %>
        <span class="record-genre-bar-symbol" aria-hidden="true"><%= record_genre_button_symbol(name) %></span>
      <% end %>
    <% end %>
  </div>
</nav>
