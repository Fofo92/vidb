<div class="d-flex flex-row justify-content-between align-items-center">
  <h1 class="justify-content-between">Liste des <%= pluralize(Record.count, "enregistrement") %></h1>
  <%= link_to new_record_path, class: "btn btn-primary fa-xl" do %>
    <i class="fa-regular fa-square-plus"></i>
  <% end %>
</div>
<div class="d-flex flex-row justify-content-between align-items-center py-2">
  <%= search_form_for @q do |f| %>
    <%= f.search_field(:french_title_or_original_title_cont, label: "Le titre contient") %>
    <%= f.submit "Recherche", class: "btn btn-primary" %>
  <% end %>
</div>
<div style="font-size: 1rem;">
  <%= paginate @records, window: 2 %>
</div>
<table class="table table-striped table-sm">
  <thead style="position: sticky">
    <tr>
      <th><%= sort_link(@q, :id, "#") %></th>
      <th><%= sort_link(@q, :french_title, "Titre") %></th>
      <th><%= sort_link(@q, :year, "Année") %></th>
      <th><%= sort_link(@q, :length_in_mn, "Durée") %></th>
      <th>Genre(s)</th>
      <th>Pays</th>
      <th>Version</th>
      <th>Support(s)</th>
      <th>Rang</th>
      <th>Parents</th>
    </tr>
  </thead>

  <tbody>
    <% @records.each do |record| %>
      <tr>
        <td><%= record.id %></td>
        <td>
          <%= link_to record.complete_title, record_path(record) %>
        </td>
        <td><%= record.year || record.display_range_of_years %></td>
        <td><%= record.formatted_total_length %></td>
        <td><%= record.genders.order(:name).map(&:name).join(", ") %></td>
        <td><%= record.countries.order(:long_name).map(&:flag).join("") %></td>
        <td><%= record.language_version.nil? ? "n/a" : record.language_version.short_name %></td>
        <td><%= record.media.map(&:short_name).join(", ") %></td>
        <td><%= record.rank || "n/a" %></td>
        <td><%= record.ancestry %></td>
        <td>
          <% if record.is_recorded? %>
            <i class="fas fa-record-vinyl" style="color:green;"></i>
          <% else %>
            <i class="fas fa-record-vinyl" style="color:red;"></i>
          <% end %>
          <% if record.is_seen? %>
            <i class="fas fa-eye" style="color:green;"></i>
          <% else %>
            <i class="fas fa-eye-slash" style="color:red;"></i>
          <% end %>
          <% if record.is_available? %>
            <i class="fas fa-folder-plus" style="color:green;"></i>
          <% else %>
            <i class="fas fa-folder-minus" style="color:red;"></i>
          <% end %>
          <% if record.is_checked? %>
            <i class="fas fa-check" style="color:green;"></i>
          <% else %>
            <i class="fas fa-xmark" style="color:red;"></i>
          <% end %>
        </td>
        <td>
          <%= link_to edit_record_path(record) do %>
            <i class="fas fa-edit"></i>
          <% end %>
          <%= link_to record_path(record),
						data: {
              turbo_method: :delete,
              turbo_confirm: "Êtes-vous sûr ?"
              } do %>
            	<i class="fas fa-trash-alt"></i>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<div style="font-size: 1rem;">
  <%= paginate @records, window: 2 %>
</div>
