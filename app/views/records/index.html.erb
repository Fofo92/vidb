<div class="d-flex flex-row justify-content-between align-items-center">
  <h1 class="justify-content-between">Liste des enregistrements (<%= pluralize(@records.count, "enregistrement") %>)</h1>
  <%= link_to new_record_path, class: "btn btn-primary fa-xl" do %>
    <i class="fa-regular fa-square-plus"></i>
  <% end %>
</div>

<table class="table table-striped table-sm">
  <thead style="position: sticky">
    <tr>
      <th>#</th><th class="w-50">Titre</th><th>Durée</th><th>Année</th>
    </tr>
  </thead>

  <tbody>
    <% @records.each do |record| %>
      <tr>
        <td><%= record.id %></td>
        <td>
          <%= link_to record.complete_title, record_path(record) %>
        </td>

        <td><%= record.formatted_total_length %><td><%= record.year %></td>
        <td>
          <% if record.is_seen? %>
            <i class="fas fa-eye" style="color:green;"></i>
          <% else %>
            <i class="fas fa-eye-slash" style="color:red;"></i>
          <% end %>
          <% if record.is_available? %>
            <i class="fas fa-folder-plus" style="color:green;"></i>
          <% else %>
            <i class="fas fa-folder-minus" style="color:red;"></i>
          <% end %>
        </td>
        <td>
          <%= link_to edit_record_path(record) do %>
            <i class="fas fa-edit"></i>
          <% end %>
          <%= link_to record_path(record),
						data: {
              turbo_method: :delete,
              turbo_confirm: "Êtes-vous sûr ?"
              } do %>
            	<i class="fas fa-trash-alt"></i>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
