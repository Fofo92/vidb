<% content_for :head do %>
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= stylesheet_link_tag "record_ratings", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "record_index", "data-turbo-track": "reload" %>
<% end %>
<div class="d-flex flex-row justify-content-between align-items-center">
  <h1 class="justify-content-between">Liste des <%= pluralize(Record.count, "enregistrement") %></h1>
  <%= link_to new_record_path(search_context: record_search_context_token), class: "btn btn-primary fa-xl", data: { record_new_link: true } do %>
    <i class="fa-regular fa-square-plus"></i>
  <% end %>
</div>
<%= render "filters" %>
<%= turbo_frame_tag 'record_search_results', target: '_top', class: 'd-block record-live-results',
                    data: { turbo_action: 'replace' } do %>
  <span hidden data-live-search-context
        data-new-record-url="<%= new_record_path(search_context: record_search_context_token) %>"
        data-search-menu-url="<%= record_search_menu_path %>"></span>
<%= render "genre_bar" %>
<%= render "rating_bar" %>
<% show_search_context = @result_count > @record_filter.matched_ids.size %>
<% if show_search_context %>
  <p><strong><%= pluralize(@record_filter.matched_ids.size, "résultat", "résultats") %></strong> —
    <%= pluralize(@result_count, "fiche affichée", "fiches affichées") %> avec leur arborescence.
    Les lignes « Arborescence » situent les résultats et ne répondent pas nécessairement aux filtres.</p>
<% else %>
  <p><strong><%= pluralize(@result_count, "fiche affichée", "fiches affichées") %></strong></p>
<% end %>
<div style="font-size: 1rem;">
  <%= paginate @records, window: 2 %>
</div>
<div class="table-responsive">
<table class="table table-striped table-sm record-index-table">
  <thead style="position: sticky">
    <tr>
      <th><%= sort_link(@q, :id, "#") %></th>
      <th><%= sort_link(@q, :french_title, "Titre") %></th>
      <th><%= sort_link(@q, :year, "Année") %></th>
      <th><%= sort_link(@q, :length_in_mn, "Durée") %></th>
      <th>Genre(s)</th>
      <th>Avis</th>
      <th>Pays</th>
      <th>Version</th>
      <th>Support(s)</th>
      <th>Rang</th>
      <th>Parents</th>
      <% if show_search_context %>
        <th data-search-context-column title="Résultats des filtres ou fiches ajoutées pour situer leur arborescence">Recherche</th>
      <% end %>
      <%= render "state_columns", record: nil, header: true, interactive: false %>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @records.each do |record| %>
      <% copies = record_copy_summary(record) %>
      <tr data-record-state-row="<%= record.id %>">
        <td><%= record.id %></td>
        <td>
          <%= link_to record.complete_title, record_path(record, search_context: record_search_context_token),
                      data: { record_title_link: record.id }, class: "record-index-title", title: record.complete_title %>
        </td>
        <td><%= render "records/year", record: record %></td>
        <td><%= copies.summary_duration %></td>
        <td><%= record_index_genres(record_metadata_values(record).genders(record)) %></td>
        <td><%= render "records/rating", record: record %></td>
        <td><%= record_metadata_values(record).countries(record).map(&:flag).join("") %></td>
        <td><%= copies.summary_languages %></td>
        <td><%= copies.summary_supports %></td>
        <td><%= record.rank || "n/a" %></td>
        <td class="record-index-parents"><%= record_filter_parent(record) %></td>
        <% if show_search_context %>
          <% matched = @record_filter.matched_ids.include?(record.id) %>
          <td data-search-role="<%= matched ? "match" : "context" %>"
              title="<%= matched ? "Cette fiche répond aux filtres de recherche." : "Fiche affichée pour situer l’arborescence d’un résultat." %>">
            <%= matched ? "Résultat" : "Arborescence" %>
          </td>
        <% end %>
        <%= render "state_columns", record: record, header: false, interactive: false %>
        <td>
          <%= link_to edit_record_path(record, search_context: record_search_context_token) do %>
            <i class="fas fa-edit"></i>
          <% end %>
          <%= link_to record_path(record, search_context: record_search_context_token),
            data: {
              turbo_method: :delete,
              turbo_confirm: "Êtes-vous sûr ?"
              } do %>
              <i class="fas fa-trash-alt"></i>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>
<div style="font-size: 1rem;">
  <%= paginate @records, window: 2 %>
</div>

<% end %>
