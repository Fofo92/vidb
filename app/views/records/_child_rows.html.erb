      <% record.children.includes(:ratings).order(:rank).each do |record| %>
        <% copies = record_copy_summary(record) %>
        <tr data-record-live-child="<%= record.id %>">
          <td><%= record.id %></td>
          <td><%= record.rank %></td>
          <td>
            <%= link_to record_path(record, search_context: record_search_context_token) do %>
              <%= record.french_title.blank? ? "" : record.french_title %>
              <%= record.original_title.blank? ? "" : " (#{record.original_title})" %>
            <% end %>
          </td>
          <td><%= render "records/year", record: record %></td>
          <td data-copy-duration="<%= record.id %>" title="Durée"><%= copies.summary_duration %></td>
          <td><%= record_metadata_values(record).genders(record).first(2).map(&:name).join(", ").presence || "—" %></td>
          <td><%= render "records/rating", record: record %></td>
          <td><%= record_metadata_values(record).countries(record).map(&:flag).join("") %></td>
          <td data-copy-languages="<%= record.id %>"><%= copies.summary_languages %></td>
          <td data-copy-supports="<%= record.id %>"><%= copies.summary_supports %></td>
          <%= render "records/state_columns", record: record, header: false %>
          <td>
            <%= link_to edit_record_path(record, search_context: record_search_context_token) do %>
              <i class="fas fa-edit"></i>
            <% end %>
          <%= link_to record_path(record, search_context: record_search_context_token),
            data: {
              turbo_method: :delete,
              turbo_confirm: "Êtes-vous sûr ?"
              } do %>
              <i class="fas fa-trash-alt"></i>
          <% end %>
          </td>
        </tr>
      <% end %>
