      <% record.children.order(:rank).each do |record| %>
        <% copies = record_copy_summary(record) %>
        <tr>
          <td><%= record.id %></td>
          <td><%= record.rank %></td>
          <td>
            <%= link_to record_path(record) do %>
              <%= record.french_title.blank? ? "" : record.french_title %>
              <%= record.original_title.blank? ? "" : " (#{record.original_title})" %>
            <% end %>
          </td>
          <td><%= record.display_range_of_years %></td>
          <td data-copy-duration="<%= record.id %>"><%= copies.duration %></td>
          <td><%= record.genders.order(:name).map(&:name).join(", ") || "néant" %></td>
          <td><%= record.countries.order(:long_name).map(&:flag).join("") %></td>
          <td data-copy-languages="<%= record.id %>"><%= copies.languages %></td>
          <td data-copy-supports="<%= record.id %>"><%= copies.supports %></td>
          <%= render "records/state_columns", record: record, header: false %>
          <td>
            <%= link_to edit_record_path(record) do %>
              <i class="fas fa-edit"></i>
            <% end %>
          <%= link_to record_path(record),
            data: {
              turbo_method: :delete,
              turbo_confirm: "Êtes-vous sûr ?"
              } do %>
              <i class="fas fa-trash-alt"></i>
          <% end %>
          </td>
        </tr>
      <% end %>
