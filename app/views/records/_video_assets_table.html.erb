<ul class="list-unstyled mb-0">
  <% assets.each do |asset| %>
    <% condition = copy_condition_summary(asset) %>
    <li data-video-asset="<%= asset.id %>" class="border-top py-2 <%= 'text-muted' unless asset.status_present? %>">
      <div class="fw-semibold text-break">
        <%= asset.last_known_path.present? ? File.basename(asset.last_known_path) : "Chemin inconnu" %>
      </div>
      <ul class="list-inline small mb-1">
        <li class="list-inline-item"><%= { "present" => "Présente", "missing" => "Introuvable", "deleted" => "Supprimée" }.fetch(asset.status) %></li>
        <li class="list-inline-item"><%= condition %></li>
        <% if asset.broadcast_part_number %>
          <li class="list-inline-item">Partie <%= asset.broadcast_part_number %>/<%= record.broadcast_part_count %></li>
        <% end %>
        <li class="list-inline-item" title="Durée mesurée du fichier, arrondie à la minute">
          <%= asset.duration_minutes ? VideoAssets::DisplaySummary.format_minutes(asset.duration_minutes) : "—" %>
        </li>
        <li class="list-inline-item" title="<%= 'Support non renseigné' unless asset.medium %>">
          <%= asset.medium&.short_name || "—" %>
        </li>
        <li class="list-inline-item" data-copy-language>
          <% if asset.language_version %>
            <%= asset.language_version.short_name %>
          <% else %>
            <span title="Version linguistique non confirmée pour cette copie ; la version de la fiche n’est pas reprise automatiquement.">À qualifier</span>
          <% end %>
        </li>
        <% if asset.byte_size %>
          <li class="list-inline-item"><%= number_to_human_size(asset.byte_size) %></li>
        <% end %>
        <% if asset.status_present? && asset.technical_details.dig('copy_preference', 'preferred') == true %>
          <li class="list-inline-item"><span class="badge text-bg-primary" data-preferred-copy>Copie privilégiée</span></li>
          <% if asset.effective_condition.fetch('damage', 'unknown') == 'unknown' %>
            <li class="list-inline-item text-muted">Qualité visuelle non évaluée</li>
          <% end %>
        <% end %>
      </ul>
      <div class="d-flex flex-wrap gap-1 align-items-center">
        <% if asset.status_present? && asset.last_known_path.to_s.end_with?('.mkv') && EncoderProjects::LaunchTicket.supported?(record) %>
          <%= link_to 'Changer de version…', encoder_copy_version_path(record, asset),
                      class: 'btn btn-sm btn-outline-primary' %>
        <% end %>
        <%= link_to 'Qualifier la copie', edit_record_copy_condition_path(record, asset),
                    class: 'btn btn-sm btn-outline-secondary' %>
        <% if asset.status_missing? && asset.technical_details['copy_removal_pending'].blank? %>
          <%= link_to new_copy_retirement_path(video_asset_ids: [asset.id]),
                      class: 'btn btn-sm btn-outline-secondary', title: 'Retirer cette ancienne référence…',
                      aria: { label: 'Retirer cette référence absente de vidb après sauvegarde' } do %>
            Retirer la référence
          <% end %>
        <% end %>
        <% if asset.status_present? || asset.technical_details['copy_removal_pending'].present? %>
          <%= link_to new_record_copy_removal_path(record, video_asset_id: asset.id),
                      class: 'btn btn-sm btn-outline-danger',
                      title: 'Supprimer cette copie…',
                      aria: { label: "Supprimer cette copie : #{File.basename(asset.last_known_path)}" } do %>
            <i class="fa-regular fa-trash-can" aria-hidden="true"></i>
          <% end %>
        <% end %>
      </div>
      <details class="small mt-1" data-copy-condition>
        <summary>Détails techniques</summary>
        <div class="pt-1 text-break">
          <% copy_condition_lines(asset).each do |line| %>
            <% next if line == condition %>
            <span class="d-block"><%= line %></span>
          <% end %>
          <p class="mb-1"><strong>Chemin :</strong> <code class="text-break" data-copy-path><%= asset.last_known_path.presence || "—" %></code></p>
          <% if asset.technical_details.dig('copy_removal', 'directory').present? %>
            <p class="mb-1"><strong>Corbeille :</strong>
              <code class="text-break"><%= asset.technical_details.dig('copy_removal', 'directory') %></code></p>
          <% end %>
          <% if asset.technical_details['copy_retirement'].present? %>
            <p class="mb-1 small">Suppression du fichier confirmée manuellement le
              <%= asset.technical_details.dig('copy_retirement', 'confirmed_at') %>.</p>
          <% end %>
          <% if asset.technical_details.present? %>
            <%= render "records/copy_technical_details", asset: asset %>
            <%= render "records/copy_provenance", asset: asset %>
          <% end %>
        </div>
      </details>
    </li>
  <% end %>
</ul>
