<div class="d-flex justify-content-between align-items-center gap-2 mb-2">
  <h1 class="h5 mb-0">État de la copie — <%= @record.complete_title %></h1>
  <%= link_to 'Retour', record_path(@record), class: 'btn btn-sm btn-outline-secondary' %>
</div>
<details class="small mb-2">
  <summary class="text-break"><%= File.basename(@asset.last_known_path.to_s) %></summary>
  <code class="text-break"><%= @asset.last_known_path %></code>
</details>
<% if @errors.present? %>
  <div class="alert alert-danger py-2 mb-2" role="alert"><%= safe_join(@errors, tag.br) %></div>
<% end %>
<%= form_with scope: :copy_condition, url: record_copy_condition_path(@record, @asset), method: :patch do |form| %>
  <%= form.hidden_field :fingerprint, value: @fingerprint %>
  <div class="row g-2 mb-2">
    <div class="col-md-6">
      <%= form.label :integrality, 'Intégralité', class: 'form-label small mb-1' %>
      <%= form.select :integrality, CopyConditionsHelper::INTEGRALITY_LABELS.map { |value, label| [label, value] },
                      { selected: @condition.fetch('integrality', 'unknown') }, class: 'form-select form-select-sm' %>
    </div>
    <div class="col-md-6">
      <%= form.label :damage, 'Détérioration', class: 'form-label small mb-1' %>
      <%= form.select :damage, CopyConditionsHelper::DAMAGE_LABELS.map { |value, label| [label, value] },
                      { selected: @condition.fetch('damage', 'unknown') }, class: 'form-select form-select-sm' %>
    </div>
    <div class="col-md-6">
      <%= form.label :retained_portion, 'Partie conservée (si incomplète)', class: 'form-label small mb-1' %>
      <%= form.select :retained_portion, CopyConditionsHelper::PORTION_LABELS.map { |value, label| [label, value] },
                      { selected: @condition.fetch('retained_portion', 'unknown') }, class: 'form-select form-select-sm' %>
    </div>
    <div class="col-6 col-md-3">
      <%= form.label :retained_duration_minutes, 'Durée conservée · min', class: 'form-label small mb-1' %>
      <%= form.number_field :retained_duration_minutes, value: @condition['retained_duration_seconds']&.div(60),
                            min: 0, max: 1440, step: 1, class: 'form-control form-control-sm' %>
    </div>
    <div class="col-6 col-md-3">
      <%= form.label :retained_duration_remainder, 'Secondes', class: 'form-label small mb-1' %>
      <%= form.number_field :retained_duration_remainder, value: @condition['retained_duration_seconds']&.modulo(60),
                            min: 0, max: 59, step: 1, class: 'form-control form-control-sm' %>
    </div>
    <div class="col-12">
      <%= form.label :note, 'Commentaire', class: 'form-label small mb-1' %>
      <%= form.text_area :note, value: @condition['note'], maxlength: 2000, rows: 2,
                        class: 'form-control form-control-sm' %>
    </div>
  </div>
  <div class="d-flex flex-wrap align-items-center gap-2">
    <%= form.submit 'Enregistrer', class: 'btn btn-sm btn-primary' %>
    <span class="small text-muted">Sans marqueur ne signifie pas vérifiée.</span>
  </div>
<% end %>
<% evidence = Array(@condition['evidence']) %>
<% if evidence.any? %>
  <details class="small mt-2">
    <summary>Historique et anciens marqueurs</summary>
    <pre class="small text-wrap"><%= JSON.pretty_generate(evidence) %></pre>
  </details>
<% end %>
