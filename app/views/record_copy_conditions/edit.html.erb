<h1>État de la copie</h1>
<p><%= @record.complete_title %></p>
<p class="text-break"><code><%= @asset.last_known_path %></code></p>
<% if @errors.present? %>
  <div class="alert alert-danger" role="alert"><%= safe_join(@errors, tag.br) %></div>
<% end %>
<p>Ces informations concernent cette copie. L’absence d’un ancien marqueur ne prouve pas son intégralité ni son bon état.</p>
<%= form_with scope: :copy_condition, url: record_copy_condition_path(@record, @asset), method: :patch do |form| %>
  <%= form.hidden_field :fingerprint, value: @fingerprint %>
  <div class="mb-3">
    <%= form.label :integrality, 'Intégralité', class: 'form-label' %>
    <%= form.select :integrality, CopyConditionsHelper::INTEGRALITY_LABELS.map { |value, label| [label, value] },
                    { selected: @condition.fetch('integrality', 'unknown') }, class: 'form-select' %>
  </div>
  <div class="mb-3">
    <%= form.label :damage, 'Détérioration', class: 'form-label' %>
    <%= form.select :damage, CopyConditionsHelper::DAMAGE_LABELS.map { |value, label| [label, value] },
                    { selected: @condition.fetch('damage', 'unknown') }, class: 'form-select' %>
  </div>
  <div class="mb-3">
    <%= form.label :retained_portion, 'Partie conservée (si copie incomplète)', class: 'form-label' %>
    <%= form.select :retained_portion, CopyConditionsHelper::PORTION_LABELS.map { |value, label| [label, value] },
                    { selected: @condition.fetch('retained_portion', 'unknown') }, class: 'form-select' %>
  </div>
  <div class="mb-3">
    <%= form.label :retained_duration_minutes, 'Durée conservée (minutes, si copie incomplète)', class: 'form-label' %>
    <%= form.number_field :retained_duration_minutes, value: @condition['retained_duration_seconds']&./(60),
                          min: 1, max: 1440, step: 1, class: 'form-control' %>
  </div>
  <div class="mb-3">
    <%= form.label :note, 'Commentaire', class: 'form-label' %>
    <%= form.text_area :note, value: @condition['note'], maxlength: 2000, class: 'form-control' %>
  </div>
  <%= form.submit 'Enregistrer l’état de cette copie', class: 'btn btn-primary' %>
  <%= link_to 'Retour à la fiche', record_path(@record), class: 'btn btn-outline-secondary' %>
<% end %>
<% evidence = Array(@condition['evidence']) %>
<% if evidence.any? %>
  <details class="mt-3">
    <summary>Historique de qualification et anciens marqueurs</summary>
    <pre class="small text-wrap"><%= JSON.pretty_generate(evidence) %></pre>
  </details>
<% end %>
