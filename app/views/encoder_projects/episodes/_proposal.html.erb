<% submitted = @submitted || {} %>
<% language = proposal['language_version'].presence %>
<% language = @scope.dig('project', 'language_hint').presence || 'IND' if language.blank? || language == 'IND' %>
<% language = submitted['language_version'] if submitted['language_version'].present? %>
<% values = proposal.merge((@submitted || {}).slice('title', 'original_title', 'year', 'abstract', 'gender_ids', 'country_ids').reject { |_key, value| value.blank? }) %>
<section class="card my-3"><div class="card-body">
<% if proposal.dig('source', 'provider').present? %>
  <div class="encoder-proposal-heading">
    <h2 class="h5">Proposition <%= index + 1 %> · <%= proposal.dig('source', 'provider') %></h2>
    <%= link_to 'Consulter la source', proposal.dig('source', 'url'), target: '_blank', rel: 'noopener' %>
  </div>
<% end %>
<% if proposal['existing_record_id'] %>
  <p><%= link_to 'Modifier ou effacer une information déjà renseignée', edit_record_path(proposal['existing_record_id']), target: '_blank', rel: 'noopener' %></p>
<% end %>
<%= form_with url: encoder_projects_episode_path, method: :post, html: { class: 'encoder-episode-form' } do |form| %>
  <%= form.hidden_field :encoder_window, value: 1 %>
  <%= render 'encoder_projects/revision_confirmation', form: form %>
  <%= form.hidden_field :request_token, value: params[:request_token] %>
  <% if proposal.present? %>
    <%= form.hidden_field :proposal_token, value: EncoderProjects::CatalogueScope.issue(user: current_user, project: @scope.fetch('project'), candidate: proposal) %>
  <% end %>
  <%= form.hidden_field :q, value: @query %>
  <% if proposal['series_candidate'] %>
    <% series = proposal.fetch('series_candidate') %>
    <p><strong>Nouvelle série : <%= series['french_title'] %></strong>
      <% if series['original_title'].present? %> (<%= series['original_title'] %>)<% end %>
      · <%= series['year'] || 'année à compléter' %></p>
    <% if proposal['tmdb_episode_reference'] %>
      <p>Seuls la série et cet épisode seront préparés ; la numérotation des autres épisodes ne sera pas déduite.</p>
    <% elsif proposal['edition_mapping'] %>
      <p>Création complète suivant la numérotation Wikipédia. Les parties du catalogue seront regroupées
        uniquement lorsque leur identité est établie ; leur nombre ne correspond pas au nombre de fiches locales.</p>
    <% else %>
      <p>Création complète : environ <%= pluralize(series['episode_count'].to_i, 'épisode', 'épisodes') %>
        dans <%= pluralize(series['season_count'].to_i, 'saison', 'saisons') %>,
        selon le catalogue qui sera actualisé à la confirmation. Aucune copie ne sera déclarée présente.</p>
    <% end %>
    <%= form.hidden_field :series_id, value: 'new' %>
  <% else %>
  <%= form.label :series_id, 'Série (vérifie aussi son année)', for: "episode-series-#{index}" %>
  <%= form.select :series_id, @series.map { |record| ["#{record.complete_title} · #{record.year} · fiche #{record.id}", record.id] }, { selected: proposal['series_id'] || params[:series_id], prompt: 'Choisir la série' }, required: true, id: "episode-series-#{index}" %>
  <% end %>
  <% if proposal['catalogue_completion'] && !proposal['series_candidate'] %>
    <% complete_catalogue = submitted.key?('complete_catalogue') ? submitted['complete_catalogue'] == '1' : true %>
    <div class="my-3">
      <%= form.check_box :complete_catalogue, { checked: complete_catalogue, id: "episode-complete-catalogue-#{index}" }, '1', '0' %>
      <%= form.label :complete_catalogue, 'Compléter toutes les saisons et tous les épisodes documentés de cette série', for: "episode-complete-catalogue-#{index}" %>
      <p class="small">Les fiches existantes et leurs états sont conservés. Les nouveaux épisodes seront non enregistrés,
        non disponibles et non visionnés. Aucun fichier ne sera rattaché ici.</p>
    </div>
  <% end %>
  <% if proposal['tmdb_episode_reference'] %>
    <% reference = proposal.fetch('tmdb_episode_reference') %>
    <div class="encoder-field encoder-field-wide">
      <p><strong>Correspondance à confirmer :</strong>
        vidb <%= format('S%02d E%02d', @episode.season, @episode.episode) %>
        ↔ TMDB <%= format('S%02d E%02d', reference.fetch('season'), reference.fetch('episode')) %>.
        Série TMDB : <%= proposal['tmdb_series_title'] %> ; épisode : <%= proposal['tmdb_episode_title'] %>.
        La numérotation locale sera conservée.</p>
      <%= form.check_box :confirm_tmdb_episode_mapping, { required: true, checked: submitted['confirm_tmdb_episode_mapping'] == '1', id: "episode-mapping-#{index}" }, '1', '0' %>
      <%= form.label :confirm_tmdb_episode_mapping, 'Je confirme qu’il s’agit du même épisode', for: "episode-mapping-#{index}" %>
    </div>
  <% end %>
  <% if proposal['edition_mapping'] %>
    <p><strong>Découpages différents : vérifie la correspondance avant confirmation.</strong>
      Les numéros locaux ci-dessous seront conservés.</p>
    <table class="table table-sm">
      <thead><tr><th>Épisode local</th><th>Titre</th><th>Épisode(s) TMDB</th><th>Durée de référence</th></tr></thead>
      <tbody>
      <% proposal['edition_mapping'].each do |row| %>
        <tr><td><%= row['local_number'] %></td><td><%= row['title'] %></td>
          <td><%= row['external_numbers'].join(' + ') %></td>
          <td><%= row['reference_runtime_minutes'] ? "#{row['reference_runtime_minutes']} min" : 'Non renseignée' %></td></tr>
      <% end %>
      </tbody>
    </table>
    <p class="small">Cette correspondance sera conservée. Aucun découpage de fichier ni aucune durée mesurée ne sera modifié.</p>
  <% end %>
  <div class="encoder-field">
  <%= form.label :title, 'Titre français de l’épisode', for: "episode-title-#{index}" %>
  <%= form.text_field :title, value: values['title'].presence || @episode.title, maxlength: 300, id: "episode-title-#{index}" %>
  <% if values['title'].blank? && @episode.title.blank? %><p class="small text-warning">Titre : à compléter.</p><% end %>
  </div>
  <div class="encoder-field">
  <%= form.label :original_title, 'Titre original', for: "episode-original-title-#{index}" %>
  <%= form.text_field :original_title, value: values['original_title'], maxlength: 300, placeholder: 'À compléter si connu', id: "episode-original-title-#{index}" %>
  <% countries = Country.where(id: values.fetch('country_ids', [])).pluck(:long_name) %>
  <% complete_title = EncoderProjects::EpisodeTitles.display(values['title'].presence || @episode.title, values['original_title'], countries: countries) %>
  <p class="small">Nom proposé : <%= format('S%02d E%02d - %s', @episode.season, @episode.episode, complete_title) %></p>
  <% if values['original_title'].blank? %><p class="small text-muted">Titre original non trouvé : tu peux le compléter ici.</p><% end %>
  </div>
  <div class="encoder-field">
  <%= form.label :language_version, 'Version linguistique prévue', for: "episode-language-#{index}" %>
  <%= form.select :language_version, LanguageVersion.order(:id).map { |item| [item.long_name, item.short_name] }, { selected: language }, id: "episode-language-#{index}" %>
  <% if language == 'IND' %>
    <p class="small text-warning">Version linguistique : à compléter ; elle sera vérifiée sur le fichier final.</p>
  <% end %>
  </div>
  <div class="encoder-field">
  <%= form.label :year, 'Année de première diffusion', for: "episode-year-#{index}" %>
  <%= form.number_field :year, value: values['year'], min: 1900, max: Date.current.year, placeholder: 'À compléter', id: "episode-year-#{index}" %>
  <% if values['year'].blank? %><p class="small text-warning">Année : à compléter.</p><% end %>
  <% if proposal['abstract_notice'].present? %><p class="small text-muted"><%= proposal['abstract_notice'] %></p><% end %>
  <% if proposal['abstract'].present? && proposal.dig('abstract_source', 'provider').present? %>
    <% synopsis_label = { 'tmdb' => 'TMDB', 'wikipedia' => 'Wikipédia', 'senscritique' => 'SensCritique' }.fetch(proposal.dig('abstract_source', 'provider'), proposal.dig('abstract_source', 'provider')) %>
    <p class="small">Synopsis : <%= link_to synopsis_label, proposal.dig('abstract_source', 'url'), target: '_blank', rel: 'noopener' %></p>
  <% end %>
  </div>
  <div class="encoder-field encoder-field-wide">
  <%= form.label :abstract, 'Résumé', for: "episode-abstract-#{index}" %>
  <% if proposal['abstract_original'].present? %>
    <div class="my-2">
      <p class="small text-warning">Résumé français non disponible sur TMDB.
        Texte proposé dans la langue « <%= proposal['abstract_original_language'] %> » : tu peux le traduire ci-dessous.</p>
      <details><summary>Consulter le résumé original</summary>
        <p class="text-break"><%= proposal['abstract_original'] %></p>
      </details>
      <p class="small">Le texte original ne sera pas enregistré dans le résumé français.</p>
    </div>
  <% end %>
  <%= form.text_area :abstract, value: values['abstract'], maxlength: 12000, placeholder: 'À compléter', id: "episode-abstract-#{index}" %>
  <% if values['abstract'].blank? %><p class="small text-warning">Résumé : à compléter.</p><% end %>
  </div>
  <div class="encoder-field">
  <%= form.label :gender_ids, 'Genres principaux (deux maximum)', for: "episode-genres-#{index}" %>
  <%= form.select :gender_ids, Gender.order(:name).map { |item| [item.name, item.id] }, { selected: values['gender_ids'] }, multiple: true, id: "episode-genres-#{index}" %>
  <% if values.fetch('gender_ids', []).empty? %><p class="small text-warning">Genres : à compléter.</p><% end %>
  </div>
  <div class="encoder-field">
  <%= form.label :country_ids, 'Pays de production', for: "episode-countries-#{index}" %>
  <%= form.select :country_ids, Country.order(:long_name).map { |item| [item.long_name, item.id] }, { selected: values['country_ids'] }, multiple: true, id: "episode-countries-#{index}" %>
  <% if values.fetch('country_ids', []).empty? %><p class="small text-warning">Pays : à compléter.</p><% end %>
  </div>
  <div class="encoder-field encoder-field-wide">
  <%= form.label :source, 'Lien de référence', for: "episode-source-#{index}" %>
  <%= form.url_field :source, value: (@submitted || {})['source'].presence || proposal.dig('source', 'url'), id: "episode-source-#{index}" %>
  </div>
  <p class="small">Un champ vide conserve la proposition disponible. Les informations déjà renseignées sont préservées, sauf correction explicite de ta part.
    Pays et genres complètent la série lorsqu’ils y manquent ; l’épisode en hérite.
    Le support HD et la durée réelle seront établis à l’import de l’encodage terminé.</p>
  <% episode_label = format('S%02d E%02d', @episode.season, @episode.episode) %>
  <div class="encoder-confirmation-bar">
    <%= form.submit(proposal['series_candidate'] ? (proposal['tmdb_episode_reference'] ? "Créer la série et préparer #{episode_label}" : "Créer la série complète et préparer #{episode_label}") : "Confirmer et préparer #{episode_label}") %>
  </div>
<% end %>
</div></section>

