<div class="container py-4">
  <h1 class="h3">Identifier l’œuvre et préparer sa fiche vidb</h1>
  <p>Wikipédia reste prioritaire pour l’identité ; le synopsis TMDB est privilégié lorsqu’il concorde. Vérifie l’œuvre avant de confirmer.</p>
  <p class="small text-break">Source : <%= @scope.fetch('project').fetch('source_paths').join(' · ') %></p>
  <div class="alert alert-info">
    <p class="mb-2">La fiche existe déjà dans vidb ou vient d’être créée ? Recherche-la dans ta vidéothèque et sélectionne-la pour ce montage.</p>
    <%= link_to 'Choisir une fiche vidb existante / Actualiser',
                encoder_projects_local_records_path(request_token: params[:request_token], q: @query),
                class: 'btn btn-outline-primary' %>
  </div>
  <%= form_with url: encoder_projects_catalogue_path, method: :get do |form| %>
    <%= form.hidden_field :request_token, value: params[:request_token] %>
    <%= form.label :q, 'Titre de l’œuvre, lien Wikipédia, TMDB ou SensCritique', class: 'form-label' %>
    <div class="d-flex gap-2 mb-3">
      <%= form.text_field :q, value: @query, maxlength: 300, class: 'form-control', required: true %>
      <%= form.submit 'Rechercher', class: 'btn btn-primary' %>
    </div>
  <% end %>
  <% Array(@source_warnings).uniq.each do |warning| %><p class="alert alert-warning"><%= warning %></p><% end %>
  <% if @search_error %><p class="alert alert-warning"><%= @search_error %></p><% end %>
  <% if @candidates.empty? && Array(@series_candidates).empty? && !@search_error %><p>Aucune proposition externe trouvée. Choisis une fiche vidb existante ci-dessus, précise le titre ou colle un lien externe.</p><% end %>
  <% Array(@series_candidates).each do |candidate| %>
    <section class="card my-3"><div class="card-body">
      <h2 class="h4"><%= candidate['title'] %> · <%= candidate['year'] || 'Année à compléter' %> · Série</h2>
      <% if candidate['original_title'].present? %><p>Titre original : <%= candidate['original_title'] %></p><% end %>
      <p><%= link_to 'Consulter TMDB', "https://www.themoviedb.org/tv/#{candidate.fetch('tmdb_id')}", target: '_blank', rel: 'noopener' %></p>
      <% project = @scope.fetch('project').merge('episode_target' => { 'season' => 1, 'episode' => 1 }) %>
      <%= form_with url: encoder_projects_episode_path, method: :get do |form| %>
        <%= form.hidden_field :request_token, value: EncoderProjects::CatalogueScope.issue(user: current_user, project: project) %>
        <%= form.hidden_field :tmdb_series_id, value: candidate.fetch('tmdb_id') %>
        <%= form.hidden_field :external_series, value: '1' %>
        <%= form.hidden_field :q, value: candidate['title'] %>
        <%= form.label :season_number, 'Saison' %>
        <%= form.number_field :season_number, value: 1, min: 0, max: 99, required: true %>
        <%= form.label :episode_number, 'Épisode' %>
        <%= form.number_field :episode_number, value: 1, min: 1, max: 999, required: true %>
        <%= form.submit 'C’est cette série : préparer l’épisode', class: 'btn btn-primary' %>
      <% end %>
      <p class="small">Vérifie le numéro de ton montage. Aucune fiche ni association n’est créée à cette étape.</p>
    </div></section>
  <% end %>
  <% @candidates.each do |candidate| %>
    <section class="card my-3"><div class="card-body">
      <h2 class="h4"><%= candidate['french_title'] %> · <%= candidate['year'] || 'Année à compléter' %> · Film</h2>
      <% if candidate['original_title'].present? %><p>Titre original : <%= candidate['original_title'] %></p><% end %>
      <p><strong>Genres :</strong> <%= candidate['genres_text'] %> · <strong>Pays :</strong>
        <%= candidate['countries_text'].presence || candidate.fetch('country_codes', []).join(', ') %></p>
      <% if candidate['abstract_notice'].present? %><p class="small text-muted"><%= candidate['abstract_notice'] %></p><% end %>
      <% if candidate['abstract'].present? && candidate.dig('abstract_source', 'provider').present? %>
        <% synopsis_label = { 'tmdb' => 'TMDB', 'wikipedia' => 'Wikipédia', 'senscritique' => 'SensCritique' }.fetch(candidate.dig('abstract_source', 'provider'), candidate.dig('abstract_source', 'provider')) %>
        <p class="small">Synopsis : <%= link_to synopsis_label, candidate.dig('abstract_source', 'url'), target: '_blank', rel: 'noopener' %></p>
      <% end %>
      <p><%= candidate['abstract'] %></p>
      <p><%= link_to candidate.fetch('source').fetch('url'), candidate.fetch('source').fetch('url'), target: '_blank', rel: 'noopener noreferrer' %></p>
      <%= form_with url: encoder_projects_catalogue_path, method: :post do |form| %>
        <%= form.hidden_field :encoder_window, value: 1 %>
        <%= form.hidden_field :request_token, value: params[:request_token] %>
        <%= form.hidden_field :proposal_token, value: EncoderProjects::CatalogueScope.issue(user: current_user, project: @scope.fetch('project'), candidate: candidate) %>
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <%= form.label :gender_ids, 'Genres principaux (deux maximum)', class: 'form-label' %>
            <%= select_tag 'gender_ids[]', options_from_collection_for_select(@genders, :id, :name, EncoderProjects::CatalogueReferences.genres(candidate)), multiple: true, size: 6, class: 'form-select' %>
          </div>
          <div class="col-md-6">
            <%= form.label :country_ids, 'Pays de production', class: 'form-label' %>
            <%= select_tag 'country_ids[]', options_from_collection_for_select(@countries, :id, :long_name, EncoderProjects::CatalogueReferences.countries(candidate)), multiple: true, size: 6, class: 'form-select' %>
          </div>
        </div>
        <p class="small">La fiche sera créée ou une fiche concordante réutilisée. La disponibilité et le support seront déterminés lors de l’import du fichier terminé.</p>
        <%= form.submit 'C’est ce film : préparer la fiche et l’associer au montage', class: 'btn btn-primary', data: { turbo_submits_with: 'Préparation de la fiche…' } %>
      <% end %>
    </div></section>
  <% end %>
</div>

