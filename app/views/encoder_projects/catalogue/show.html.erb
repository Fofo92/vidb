<div class="container py-4">
  <h1 class="h3">Identifier le film et préparer sa fiche vidb</h1>
  <p>Recherche Wikipédia prioritaire, puis TMDB si aucun film n’est proposé. Vérifie l’œuvre avant de confirmer.</p>
  <p class="small text-break">Source : <%= @scope.fetch('project').fetch('source_paths').join(' · ') %></p>
  <%= form_with url: encoder_projects_catalogue_path, method: :get do |form| %>
    <%= form.hidden_field :request_token, value: params[:request_token] %>
    <%= form.label :q, 'Titre du film, lien Wikipédia ou lien TMDB', class: 'form-label' %>
    <div class="d-flex gap-2 mb-3">
      <%= form.text_field :q, value: @query, maxlength: 300, class: 'form-control', required: true %>
      <%= form.submit 'Rechercher', class: 'btn btn-primary' %>
    </div>
  <% end %>
  <% if @search_error %><p class="alert alert-warning"><%= @search_error %></p><% end %>
  <% if @candidates.empty? && !@search_error %><p>Aucun film trouvé. Précise le titre ou colle son lien Wikipédia ou TMDB.</p><% end %>
  <% @candidates.each do |candidate| %>
    <section class="card my-3"><div class="card-body">
      <h2 class="h4"><%= candidate['french_title'] %> · <%= candidate['year'] || 'Année à compléter' %></h2>
      <p><strong>Genres :</strong> <%= candidate['genres_text'] %> · <strong>Pays :</strong>
        <%= candidate['countries_text'].presence || candidate.fetch('country_codes', []).join(', ') %></p>
      <p><%= candidate['abstract'] %></p>
      <p><%= link_to candidate.fetch('source').fetch('url'), candidate.fetch('source').fetch('url'), target: '_blank', rel: 'noopener noreferrer' %></p>
      <%= form_with url: encoder_projects_catalogue_path, method: :post do |form| %>
        <%= form.hidden_field :request_token, value: params[:request_token] %>
        <%= form.hidden_field :proposal_token, value: EncoderProjects::CatalogueScope.issue(user: current_user, project: @scope.fetch('project'), candidate: candidate) %>
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <%= form.label :gender_ids, 'Genres principaux (deux maximum)', class: 'form-label' %>
            <%= select_tag 'gender_ids[]', options_from_collection_for_select(@genders, :id, :name, EncoderProjects::CatalogueReferences.genres(candidate)), multiple: true, size: 6, class: 'form-select' %>
          </div>
          <div class="col-md-6">
            <%= form.label :country_ids, 'Pays de production', class: 'form-label' %>
            <%= select_tag 'country_ids[]', options_from_collection_for_select(@countries, :id, :long_name, EncoderProjects::CatalogueReferences.countries(candidate)), multiple: true, size: 6, class: 'form-select' %>
          </div>
        </div>
        <p class="small">La fiche sera créée ou une fiche concordante réutilisée. La disponibilité et le support seront déterminés lors de l’import du fichier terminé.</p>
        <%= form.submit 'C’est ce film : préparer la fiche et l’associer au montage', class: 'btn btn-primary', data: { turbo_submits_with: 'Préparation de la fiche…' } %>
      <% end %>
    </div></section>
  <% end %>
</div>
