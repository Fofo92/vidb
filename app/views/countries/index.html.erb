<div class="d-flex justify-content-between align-items-center">
  <h1>Pays</h1>
  <%= link_to new_country_path, class: "btn btn-primary fa-xl" do %>
    <i class="fa-regular fa-square-plus"></i>
  <% end %>
</div>

<% if @countries.empty? %>
  <h5>Liste vide</h5>
<% else %>
  <table class="table table-hover">
    <thead>
      <tr>
        <th scope="col">#</th>
        <th scope="col">Code</th>
        <th scope="col">Nom</th>
      </tr>
    </thead>
     	<%= "🇦🇷🇦🇷" %>
      <%= "fr".dup.force_encoding('UTF-8').encode(
        'UTF-8',
        invalid: :replace,
        undef: :replace,
        replace: ''
      ) %>
    <tbody>
      <% @countries.each do |country| %>
        <tr>
          <td scope="row"><%= country.id %></td>
          <td scope="row"><%= country.short_name %></td>
          <td scope="row"><%= country.long_name %></td>
          <td scope="row"><%= country.country_flag(country.short_name) %></td>
          <td class="text-center">
          <%= link_to edit_country_path(country) do %>
            <i class="fas fa-edit"></i>
          <% end %>
          <%= link_to country, data: {turbo_method: :delete, turbo_confirm: "Êtes-vous sûr ?" } do %>
            <i class="fas fa-trash-alt"></i>
          <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
