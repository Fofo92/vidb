<section class="card my-3" data-record-metadata-overview>
  <div class="card-body py-2">
    <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
      <h2 class="h5 mb-0 me-2">Complétude des fiches</h2>
      <p class="small mb-0">
        <strong><%= audit[:incomplete] %></strong> incomplètes ·
        <strong><%= audit[:review] %></strong> à consolider ·
        <strong><%= audit[:to_work] %>/<%= audit[:total] %></strong> à traiter
      </p>
    </div>
    <div class="row g-3">
      <div class="col-lg-7">
        <div class="table-responsive">
          <table class="table table-sm small align-middle mb-1">
            <thead><tr><th>Type de fiche</th><th class="text-end">Total</th><th class="text-end">Incomplètes</th><th class="text-end">À consolider</th><th class="text-end">À traiter</th></tr></thead>
            <tbody>
              <% RecordMetadataAudit::GROUP_LABELS.each do |group, label| %>
                <% counts = audit[:groups].fetch(group) %>
                <tr><th scope="row"><%= label %></th><td class="text-end"><%= counts[:total] %></td><td class="text-end"><%= counts[:incomplete] %></td><td class="text-end"><%= counts[:review] %></td><td class="text-end"><%= counts[:to_work] %></td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="col-lg-5">
        <table class="table table-sm small mb-1">
          <thead><tr><th>Information manquante</th><th class="text-end">Fiches</th></tr></thead>
          <tbody>
            <% RecordMetadataAudit::LABELS.each do |field, label| %>
              <tr><th scope="row"><%= label %></th><td class="text-end"><%= audit[:missing][field] %></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <details class="small text-muted mt-1">
      <summary>Règles du bilan · actualisation sous une minute</summary>
      <p class="mb-0 mt-1">Une fiche peut manquer de plusieurs informations : ces colonnes ne s’additionnent pas.
        Les années, versions et supports manquants sont comptés sur les vidéos.
        Les pays et genres communs sont à renseigner sur la série ; ses épisodes en héritent, sauf exception explicite.
        Le résumé d’une saison est facultatif.</p>
    </details>
  </div>
</section>
