<% content_for :head do %>
  <%= stylesheet_link_tag "reconciliation_workbench", "data-turbo-track": "reload" %>
<% end %>
<div class="container workbench-dashboard">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
    <div>
      <h1 class="h2">Qualification et rapprochement</h1>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <%= button_to "Actualiser", refresh_reconciliation_workbench_path, class: "btn btn-outline-primary btn-sm" %>
      <%= button_to "Appliquer les règles", apply_reconciliation_workbench_path, class: "btn btn-primary btn-sm" %>
    </div>
  </div>
  <% if @overview[:available] %>
    <div class="alert alert-light border d-flex flex-wrap gap-2 workbench-inventory">
      <span><strong><%= number_with_delimiter(@overview[:confirmed]) %></strong> copies confirmées</span>
      <span><strong><%= number_with_delimiter(@overview[:remaining]) %></strong> fichiers à rapprocher</span>
      <span class="text-muted">Scan <%= @overview[:inventory_at].in_time_zone('Europe/Paris').strftime('%d/%m à %H:%M') %></span>
    </div>
  <% end %>
  <turbo-frame id="workbench_status" src="<%= status_reconciliation_workbench_path %>"
               data-controller="workbench-progress" class="d-block mb-2"></turbo-frame>
  <p class="mb-2"><%= link_to "Consolider par lot", reconciliation_workbench_reviews_path(axis: @axis),
                  class: "btn btn-outline-primary btn-sm", data: { consolidation_queue: true } %></p>
  <nav class="nav nav-tabs mb-2" aria-label="Les deux axes du travail">
    <%= link_to "1 · Caractéristiques des œuvres", reconciliation_workbench_path(axis: 'metadata'), class: "nav-link #{@axis == 'metadata' ? 'active' : ''}" %>
    <%= link_to "2 · Liens avec le disque", reconciliation_workbench_path(axis: 'disk'), class: "nav-link #{@axis == 'disk' ? 'active' : ''}" %>
  </nav>
  <% if @axis == 'metadata' %>
    <p class="small text-muted mb-2">Métadonnées des œuvres. Leur validation ne confirme aucune copie sur disque.</p>
  <% else %>
    <p class="small text-muted mb-2">Rattachement des fichiers aux œuvres ; les métadonnées se traitent séparément.</p>
  <% end %>
  <div class="workbench-families mb-2">
    <% @rules.each do |rule| %>
      <% pending = ReconciliationCase.current.where(rule_key: rule.key, rule_version: rule.version, status: %w[pending blocked]) %>
      <% excluded = 0; legacy_count = 0 %>
      <% decision = ReconciliationRuleDecision.find_by(rule_key: rule.key, rule_version: rule.version) %>
      <% next if pending.none? && rule.key.start_with?('sourced_') && decision.nil? %>
      <div class="workbench-family">
        <section class="card h-100 workbench-family-card">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between gap-2 mb-2">
              <span class="badge text-bg-light border"><%= workbench_decision_label(decision&.decision) %></span>
              <span class="text-muted small">Règle v<%= rule.version %></span>
            </div>
            <h3 class="h5"><%= rule.title %></h3>
            <details class="small workbench-rule-details">
              <summary>Détails</summary>
              <p><%= rule.proposal %></p>
              <p class="text-muted"><%= rule.limits %></p>
              <% if [ReconciliationWorkbench::Rules::SOURCED_STRUCTURE.key, ReconciliationWorkbench::Rules::SERIES_CREATION.key].include?(rule.key) %>
                <% excluded = workbench_applied_structure_exclusions(rule.key).sum { |item| item.payload['held'].size } %>
                <% if excluded.positive? %><p class="small"><%= excluded %> fichiers laissés de côté dans les dossiers appliqués, à réexaminer.</p><% end %>
                <% legacy_count = workbench_legacy_structures(rule.key).size %>
                <% if legacy_count.positive? %><p class="small"><%= legacy_count %> anciens dossiers à réimporter pour cette version de la règle.</p><% end %>
              <% end %>
            </details>
            <div class="mt-auto">
              <p class="small mb-1"><strong><%= pending.count %></strong> propositions · <strong><%= workbench_file_count(pending) %></strong> fichiers</p>
              <% if excluded.positive? || legacy_count.positive? %>
                <p class="small text-muted mb-1">
                  <% if excluded.positive? %><%= excluded %> fichiers exclus<% end %>
                  <% if excluded.positive? && legacy_count.positive? %> · <% end %>
                  <% if legacy_count.positive? %><%= legacy_count %> anciens dossiers<% end %>
                </p>
              <% end %>
              <%= link_to "Examiner", reconciliation_workbench_family_path(rule.key), class: "btn btn-outline-primary btn-sm" %>
            </div>
          </div>
        </section>
      </div>
    <% end %>
  </div>
  <% if @axis == 'metadata' %>
    <details class="border rounded p-2 mb-2">
      <summary>Ajouter des propositions documentées</summary>
      <p class="mt-2 small">Document de métadonnées ou plan-22-series.json. L’import prépare des propositions, sans les appliquer.</p>
      <%= form_with url: proposals_reconciliation_workbench_path, multipart: true do |form| %>
        <%= form.label :proposals, "Document de propositions (JSON)", class: "form-label" %>
        <%= form.file_field :proposals, accept: "application/json,.json", required: true, class: "form-control mb-2" %>
        <%= form.submit "Ajouter à l’examen des familles", class: "btn btn-outline-primary btn-sm" %>
      <% end %>
    </details>
  <% end %>
  <section class="border rounded p-2 workbench-exceptions">
    <div>
      <h2 class="h6 mb-1">Exceptions</h2>
      <details class="small">
        <summary>Cas à arbitrer</summary>
        <p class="mb-0">Identités incertaines, copies concurrentes ou hiérarchies manquantes.
          Les autres familles restent traitables ; les cas peuvent être différés ou écartés.</p>
      </details>
    </div>
    <%= link_to "Examiner les exceptions", exceptions_reconciliation_workbench_path, class: "btn btn-outline-secondary btn-sm" %>
  </section>
</div>
