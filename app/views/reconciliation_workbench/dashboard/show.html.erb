<div class="container py-4">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <p class="text-uppercase text-muted small mb-1">Vidéothèque · décisions par famille</p>
      <h1 class="h2">Qualification et rapprochement</h1>
      <p class="text-muted mb-0">Tu valides les règles ; vidb applique les cas équivalents et rassemble les exceptions.</p>
    </div>
    <div class="d-flex gap-2">
      <%= button_to "Actualiser les propositions", refresh_reconciliation_workbench_path, class: "btn btn-outline-primary" %>
      <%= button_to "Appliquer les règles validées", apply_reconciliation_workbench_path, class: "btn btn-primary" %>
    </div>
  </div>
  <% if @overview[:available] %>
    <div class="alert alert-light border d-flex flex-wrap gap-4">
      <span><strong><%= number_with_delimiter(@overview[:confirmed]) %></strong> copies confirmées</span>
      <span><strong><%= number_with_delimiter(@overview[:remaining]) %></strong> fichiers encore à rapprocher</span>
      <span class="text-muted">Scan du <%= @overview[:inventory_at].in_time_zone('Europe/Paris').strftime('%d/%m à %H:%M') %></span>
    </div>
  <% end %>
  <turbo-frame id="workbench_status" src="<%= status_reconciliation_workbench_path %>"
               data-controller="workbench-progress" class="d-block mb-4"></turbo-frame>
  <nav class="nav nav-tabs mb-4" aria-label="Les deux axes du travail">
    <%= link_to "1 · Caractéristiques des œuvres", reconciliation_workbench_path(axis: 'metadata'), class: "nav-link #{@axis == 'metadata' ? 'active' : ''}" %>
    <%= link_to "2 · Liens avec le disque", reconciliation_workbench_path(axis: 'disk'), class: "nav-link #{@axis == 'disk' ? 'active' : ''}" %>
  </nav>
  <% if @axis == 'metadata' %>
    <h2 class="h4">Que sait-on de l’œuvre ?</h2>
    <p>Nature, année, résumé, pays, genres et langue de la fiche. Les propositions externes présentent leur identité et leurs sources. Leur validation ne confirme aucune copie sur disque.</p>
  <% else %>
    <h2 class="h4">Quel fichier correspond à quelle fiche ?</h2>
    <p>Identité, stabilité et rattachement des copies. Une copie confirmée n’implique pas que les caractéristiques de l’œuvre sont complètes.</p>
  <% end %>
  <div class="row g-3 mb-4">
    <% @rules.each do |rule| %>
      <% pending = ReconciliationCase.current.where(rule_key: rule.key, rule_version: rule.version, status: %w[pending blocked]) %>
      <% decision = ReconciliationRuleDecision.find_by(rule_key: rule.key, rule_version: rule.version) %>
      <% next if pending.none? && rule.key.start_with?('sourced_') && decision.nil? %>
      <div class="col-lg-6">
        <section class="card h-100">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between gap-2 mb-2">
              <span class="badge text-bg-light border"><%= workbench_decision_label(decision&.decision) %></span>
              <span class="text-muted small">Règle v<%= rule.version %></span>
            </div>
            <h3 class="h5"><%= rule.title %></h3>
            <p><%= rule.proposal %></p>
            <p class="small text-muted"><%= rule.limits %></p>
            <div class="mt-auto">
              <p class="mb-2"><strong><%= pending.count %></strong> propositions · <strong><%= workbench_file_count(pending) %></strong> fichiers concernés</p>
              <% if rule.key == ReconciliationWorkbench::Rules::SOURCED_STRUCTURE.key %>
                <% excluded = workbench_applied_structure_exclusions.sum { |item| item.payload['held'].size } %>
                <% if excluded.positive? %><p class="small"><%= excluded %> fichiers laissés de côté dans les dossiers appliqués, à réexaminer.</p><% end %>
                <% if workbench_legacy_structures.any? %><p class="small"><%= workbench_legacy_structures.size %> anciens dossiers à réimporter pour cette version de la règle.</p><% end %>
              <% end %>
              <%= link_to "Examiner la famille", reconciliation_workbench_family_path(rule.key), class: "btn btn-outline-primary btn-sm" %>
            </div>
          </div>
        </section>
      </div>
    <% end %>
  </div>
  <% if @axis == 'metadata' %>
    <details class="border rounded p-3 mb-4">
      <summary>Ajouter des propositions documentées</summary>
      <p class="mt-3 small">Ajoute un document de caractéristiques ou un dossier de préparation des structures de séries (fichier plan-22-series.json extrait du dossier). Les créations et réutilisations apparaîtront par série, avec leurs sources et les cas laissés à arbitrer. L’ajout ne vaut pas validation et ne lance aucune application.</p>
      <%= form_with url: proposals_reconciliation_workbench_path, multipart: true do |form| %>
        <%= form.label :proposals, "Document de propositions (JSON)", class: "form-label" %>
        <%= form.file_field :proposals, accept: "application/json,.json", required: true, class: "form-control mb-2" %>
        <%= form.submit "Ajouter à l’examen des familles", class: "btn btn-outline-primary btn-sm" %>
      <% end %>
    </details>
  <% end %>
  <section class="border rounded p-3">
    <h2 class="h5">Exceptions à instruire ensemble</h2>
    <p>Une identité incertaine, plusieurs copies candidates ou une hiérarchie absente restent des propositions. Elles ne bloquent pas les autres familles.</p>
    <%= link_to "Voir les groupes d’exceptions", exceptions_reconciliation_workbench_path, class: "btn btn-outline-secondary btn-sm" %>
    <p class="text-muted small mt-2 mb-0">Les règles validées continuent à traiter les nouveaux cas équivalents. Tu peux les différer ou les écarter à tout moment.</p>
  </section>
</div>
