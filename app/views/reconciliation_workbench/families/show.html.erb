<% content_for :head do %>
  <%= stylesheet_link_tag "reconciliation_family", "data-turbo-track": "reload" %>
<% end %>
<div class="container workbench-family-page">
  <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <%= link_to "← Les familles", reconciliation_workbench_path(axis: @rule.axis), class: "small" %>
    <%= link_to "Consolider par lot", reconciliation_workbench_reviews_path(axis: @rule.axis), class: "btn btn-outline-primary btn-sm" %>
  </nav>
  <h1 class="h3"><%= @rule.title %></h1>
  <details class="small mb-2">
    <summary>Portée et limites</summary>
    <p class="mb-1"><%= @rule.proposal %></p>
    <p class="mb-0"><%= @rule.limits %></p>
  </details>
  <div class="bg-light border rounded p-2 mb-2 small">
    <p class="mb-0"><strong><%= @total %> propositions.</strong>
      <% if @rule.recurring %>
        Validation : cas actuels et futurs équivalents, pour cette version de la règle.
      <% else %>
        Validation : propositions actuelles, toutes les pages de cette famille.
      <% end %>
    </p>
  </div>
  <% @cases.each do |item| %>
    <% payload = item.payload %>
    <% arbitration = @rule.key == ReconciliationWorkbench::Rules::PREFERENCE.key && payload.fetch('samples', []).size >= 2 %>
    <% suggestion = ReconciliationWorkbench::CopySuggestion.call(payload) if arbitration %>
    <article class="card mb-2">
      <div class="card-body">
        <h2 class="h5"><%= payload['record_id'] ? link_to(payload['title'], record_path(payload['record_id'])) : payload['title'] %></h2>
        <% if payload['comparison'] %>
          <% if payload['comparison']['reason'].present? && payload['comparison']['reason'] != item.error %>
            <p class="small mb-1"><%= payload['comparison']['reason'] %></p>
          <% end %>
          <p class="small text-muted mb-2">Qualité visuelle non évaluée · Tous les fichiers sont conservés.</p>
          <% if payload.fetch('samples', []).empty? %>
            <ul class="small text-break"><% payload.fetch('copies', []).each do |_id, path| %><li><%= path %></li><% end %></ul>
          <% end %>
          <% if arbitration %>
            <details class="small mb-2"><summary>Critères de suggestion</summary>
              <p class="mb-0">Date, taille, pistes, durée et définition. Langues et qualité visuelle à vérifier.
                Confirme les choix en bas de page.</p>
            </details>
            <label class="small d-block mb-2">
              <%= radio_button_tag "choices[#{item.id}]", 'defer', suggestion.nil?, form: 'copy-arbitration' %>
              Décider plus tard
            </label>
          <% end %>
          <% if payload['manual_review'] %>
            <p class="small">Choix humain confirmé le <%= Time.iso8601(payload['manual_review']['reviewed_at']).in_time_zone('Europe/Paris').strftime('%d/%m/%Y à %H:%M') %>. Langues mesurées conservées.</p>
            <% if payload['manual_review']['comment'].present? %><p><%= payload['manual_review']['comment'] %></p><% end %>
          <% end %>
          <div class="table-responsive"><table class="table table-sm" data-copy-comparison>
            <thead><tr><th>Copie</th><th class="workbench-copy-nowrap">Date</th><th class="workbench-copy-nowrap">Taille</th><th>Audio</th><th><abbr title="Sous-titres">ST</abbr></th><th>Choix</th></tr></thead>
            <tbody>
              <% payload.fetch('samples', []).each do |sample| %>
                <% capabilities = payload.dig('comparison', 'capabilities', sample['asset_id'].to_s) || {} %>
                <tr>
                  <td class="workbench-copy-path">
                    <span title="<%= sample['path'] %>"><%= File.basename(sample['path'].to_s) %></span>
                    <details class="small mt-1"><summary>Chemin et pistes</summary>
                      <p class="text-break mb-1"><%= sample['path'] %></p>
                      <p class="mb-1">Durée mesurée : <%= sample.dig('measurement', 'measured_duration_seconds') || 'À mesurer' %> secondes.</p>
                      <ul>
                        <% Array(sample.dig('measurement', 'technical_details', 'streams')).each do |stream| %>
                          <li><%= workbench_stream_description(stream) %><% if stream['codec_type'] == 'video' %> · <%= stream['width'] %> × <%= stream['height'] %><% end %></li>
                        <% end %>
                      </ul>
                    </details>
                  </td>
                  <td class="workbench-copy-nowrap"><%= Time.iso8601(sample['modified_at']).in_time_zone('Europe/Paris').strftime('%d/%m/%Y') %></td>
                  <td class="workbench-copy-nowrap"><%= number_to_human_size(sample.dig('measurement', 'byte_size')) %></td>
                  <td>
                    <%= Array(capabilities['audio']).map(&:first).uniq.join(', ').presence || workbench_track_languages(sample, 'audio') %>
                    <% Array(capabilities['language_assumptions']).each do |assumption| %>
                      <p class="small text-muted mb-0"><%= assumption %></p>
                    <% end %>
                  </td>
                  <td><%= Array(capabilities['subtitles']).map(&:first).uniq.join(', ').presence || workbench_track_languages(sample, 'subtitle') %></td>
                  <td>
                    <% if arbitration %>
                      <label class="workbench-copy-choice">
                        <%= radio_button_tag "choices[#{item.id}]", sample['asset_id'], suggestion == sample['asset_id'], form: 'copy-arbitration' %>
                        Privilégier
                      </label>
                      <% if suggestion == sample['asset_id'] %><span class="badge bg-secondary">Suggestion</span><% end %>
                    <% else %>
                      <%= (payload.dig('manual_review', 'preferred_asset_id') || payload['comparison']['preferred_asset_id']) == sample['asset_id'] ? 'Privilégier' : 'Conserver' %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table></div>
        <% elsif payload['field'] %>
          <div class="row g-3">
            <div class="col-md-6"><strong>Valeur actuelle</strong><p class="text-muted"><%= workbench_value(payload['field'], payload['before']) %></p></div>
            <div class="col-md-6"><strong>Valeur proposée</strong><p><%= workbench_value(payload['field'], payload['value']) %></p></div>
          </div>
        <% elsif payload['season_titles'] %>
          <p>Seuls les titres du catalogue changent. Les noms des répertoires sur disque restent identiques.</p>
          <ul>
            <% payload['season_titles'].each do |id, change| %>
              <li><%= link_to change['before'], record_path(id) %> → <%= change['after'] %></li>
            <% end %>
          </ul>
        <% elsif payload['operations'] %>
          <%= render 'reconciliation_workbench/series_structure', payload: payload %>
        <% elsif payload['roles'] %>
          <p><%= payload['roles'].size %> fiches dont le rôle sera précisé ; <%= payload['file_count'] %> fichiers concernés. Les liens de parenté restent identiques.</p>
          <details><summary>Voir les rôles proposés</summary><ul class="mt-2">
            <% payload['roles'].each do |id, role| %>
              <li><%= payload.dig('records', id, 'attributes', 'french_title') %> → <%= { 'series' => 'série', 'season' => 'saison', 'episode' => 'épisode' }.fetch(role) %></li>
            <% end %>
          </ul></details>
        <% else %>
          <p class="text-break"><%= payload['path'] %></p>
          <p class="small text-muted">Le fichier sera rattaché à cette fiche, sans déplacement ni changement de nom.</p>
        <% end %>
        <% if @rule.key == ReconciliationWorkbench::Rules::ENCODER_PROJECT.key %>
          <p><%= workbench_encoder_reason(payload) %></p>
          <%= render 'reconciliation_workbench/encoder_association_diagnostic', payload: payload %>
        <% elsif payload['reason'] %>
          <p><%= payload['reason'] %></p>
        <% end %>
        <% Array(payload['sources']).each do |url| %>
          <p class="small mb-1 text-break"><%= link_to url, url, target: '_blank', rel: 'noopener noreferrer' %></p>
        <% end %>
        <% if item.error.present? %><p class="text-danger small mt-2 mb-0"><strong>Exception :</strong> <%= item.error %></p><% end %>
      </div>
    </article>
  <% end %>
  <nav class="d-flex gap-3 mb-2" aria-label="Pages des propositions">
    <% if @page > 1 %><%= link_to "Page précédente", reconciliation_workbench_family_path(@rule.key, page: @page - 1) %><% end %>
    <span>Page <%= @page %> · <%= @total %> propositions au total</span>
    <% if @page * 30 < @total %><%= link_to "Page suivante", reconciliation_workbench_family_path(@rule.key, page: @page + 1) %><% end %>
  </nav>
  <% if [ReconciliationWorkbench::Rules::SOURCED_STRUCTURE.key, ReconciliationWorkbench::Rules::SERIES_CREATION.key].include?(@rule.key) %>
    <%= render 'reconciliation_workbench/structure_backlog' %>
  <% end %>
  <% if @rule.key == ReconciliationWorkbench::Rules::PREFERENCE.key %>
    <section class="card mb-2"><div class="card-body">
      <h2 class="h5">Confirmer les copies</h2>
      <p class="small">Choix de cette page uniquement. Les autres restent à examiner.
        Aucune règle pour les futurs conflits, aucun fichier supprimé.</p>
      <%= form_with url: arbitrate_reconciliation_workbench_family_path(@rule.key), method: :post, id: 'copy-arbitration', class: 'workbench-copy-confirmation' do |form| %>
        <%= form.hidden_field :scope_digest, value: @scope_digest %>
        <%= form.hidden_field :page, value: @page %>
        <div>
          <%= form.label :comment, "Commentaire facultatif", class: 'form-label small mb-1' %>
          <%= form.text_area :comment, rows: 1, class: 'form-control form-control-sm' %>
        </div>
        <%= form.submit 'Confirmer et appliquer', class: 'btn btn-primary btn-sm', disabled: @total.zero? %>
      <% end %>
    </div></section>
  <% end %>
  <% if @rule.key == ReconciliationWorkbench::Rules::ENCODER_PROJECT.key %>
    <p>Choisis une seule fiche par projet dans la file de consolidation. Une validation globale de cette famille est désactivée.</p>
  <% else %>
  <section class="card"><div class="card-body">
    <h2 class="h5">Valider la règle</h2>
    <% if @scope.where(status: 'blocked').exists? %>
      <p class="small text-muted">Pour réexaminer une fiche modifiée, diffère la famille puis actualise les propositions. Tu pourras examiner leur nouvel état avant une nouvelle validation.</p>
    <% end %>
    <%= form_with url: decision_reconciliation_workbench_family_path(@rule.key), method: :post do |form| %>
      <%= form.hidden_field :scope_digest, value: @scope_digest %>
      <%= form.label :comment, "Commentaire", class: "form-label small mb-1" %>
      <%= form.text_area :comment, value: @decision&.comment, rows: 1, class: "form-control form-control-sm mb-2" %>
      <div class="d-flex flex-wrap gap-2">
        <%= form.button "Valider et lancer les règles approuvées", name: 'decision', value: 'approved', disabled: @total.zero?, class: "btn btn-primary btn-sm", data: { turbo_submits_with: 'Enregistrement de la validation…' } %>
        <%= form.button "À préciser", name: 'decision', value: 'deferred', class: "btn btn-outline-secondary btn-sm" %>
        <%= form.button "Écarter cette règle", name: 'decision', value: 'rejected', class: "btn btn-outline-danger btn-sm" %>
      </div>
      <p class="small text-muted mt-2 mb-0">Validation limitée à cet axe. Les autres règles approuvées restent actives.</p>
    <% end %>
  </div></section>
  <% end %>
</div>
