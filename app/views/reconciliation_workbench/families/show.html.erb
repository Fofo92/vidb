<div class="container py-4">
  <%= link_to "← Les familles", reconciliation_workbench_path(axis: @rule.axis), class: "small" %>
  <h1 class="h3 mt-3"><%= @rule.title %></h1>
  <p class="lead"><%= @rule.proposal %></p>
  <div class="bg-light border rounded p-3 mb-3">
    <p class="mb-1"><strong>Limites de la règle :</strong> <%= @rule.limits %></p>
    <p class="mb-0"><strong><%= @total %> propositions actuelles.</strong>
      <% if @rule.recurring %>
        La validation autorise aussi les futurs cas équivalents de cette version de la règle.
      <% else %>
        La validation couvre uniquement les propositions actuelles de toutes les pages de cette famille.
      <% end %>
    </p>
  </div>
  <% @cases.each do |item| %>
    <% payload = item.payload %>
    <% arbitration = @rule.key == ReconciliationWorkbench::Rules::PREFERENCE.key && payload.fetch('samples', []).size >= 2 %>
    <% suggestion = ReconciliationWorkbench::CopySuggestion.call(payload) if arbitration %>
    <article class="card mb-3">
      <div class="card-body">
        <h2 class="h5"><%= payload['record_id'] ? link_to(payload['title'], record_path(payload['record_id'])) : payload['title'] %></h2>
        <% if payload['comparison'] %>
          <p>Comparaison automatique : <%= payload['comparison']['reason'] %></p>
          <p class="small text-muted">Qualité visuelle non évaluée. Les anciennes copies restent présentes ; aucun fichier n’est supprimé.</p>
          <% if payload.fetch('samples', []).empty? %>
            <ul class="small text-break"><% payload.fetch('copies', []).each do |_id, path| %><li><%= path %></li><% end %></ul>
          <% end %>
          <% if arbitration %>
            <p class="small">Choisis la copie à privilégier, puis confirme les choix de cette page en bas. La suggestion tient compte de la date, de la taille, des pistes, de la durée et de la définition ; elle ne garantit pas les langues ni la qualité visuelle.</p>
            <label class="small d-block mb-2">
              <%= radio_button_tag "choices[#{item.id}]", 'defer', suggestion.nil?, form: 'copy-arbitration' %>
              Laisser cet épisode à examiner
            </label>
          <% end %>
          <% if payload['manual_review'] %>
            <p class="small">Choix humain confirmé le <%= Time.iso8601(payload['manual_review']['reviewed_at']).in_time_zone('Europe/Paris').strftime('%d/%m/%Y à %H:%M') %>. Langues mesurées conservées.</p>
            <% if payload['manual_review']['comment'].present? %><p><%= payload['manual_review']['comment'] %></p><% end %>
          <% end %>
          <div class="table-responsive"><table class="table table-sm" data-copy-comparison>
            <thead><tr><th>Copie</th><th>Date du fichier</th><th>Taille</th><th>Audio</th><th>Sous-titres</th><th>Choix proposé</th></tr></thead>
            <tbody>
              <% payload.fetch('samples', []).each do |sample| %>
                <% capabilities = payload.dig('comparison', 'capabilities', sample['asset_id'].to_s) || {} %>
                <tr>
                  <td class="text-break">
                    <%= sample['path'] %>
                    <details class="small mt-1"><summary>Durée, définition et détail des pistes</summary>
                      <p class="mb-1">Durée mesurée : <%= sample.dig('measurement', 'measured_duration_seconds') || 'À mesurer' %> secondes.</p>
                      <ul>
                        <% Array(sample.dig('measurement', 'technical_details', 'streams')).each do |stream| %>
                          <li><%= workbench_stream_description(stream) %><% if stream['codec_type'] == 'video' %> · <%= stream['width'] %> × <%= stream['height'] %><% end %></li>
                        <% end %>
                      </ul>
                    </details>
                  </td>
                  <td><%= Time.iso8601(sample['modified_at']).in_time_zone('Europe/Paris').strftime('%d/%m/%Y') %></td>
                  <td><%= number_to_human_size(sample.dig('measurement', 'byte_size')) %></td>
                  <td>
                    <%= Array(capabilities['audio']).map(&:first).uniq.join(', ').presence || workbench_track_languages(sample, 'audio') %>
                    <% Array(capabilities['language_assumptions']).each do |assumption| %>
                      <p class="small text-muted mb-0"><%= assumption %></p>
                    <% end %>
                  </td>
                  <td><%= Array(capabilities['subtitles']).map(&:first).uniq.join(', ').presence || workbench_track_languages(sample, 'subtitle') %></td>
                  <td>
                    <% if arbitration %>
                      <label>
                        <%= radio_button_tag "choices[#{item.id}]", sample['asset_id'], suggestion == sample['asset_id'], form: 'copy-arbitration' %>
                        Privilégier cette copie
                      </label>
                      <% if suggestion == sample['asset_id'] %><span class="badge bg-secondary">Suggestion à confirmer</span><% end %>
                    <% else %>
                      <%= (payload.dig('manual_review', 'preferred_asset_id') || payload['comparison']['preferred_asset_id']) == sample['asset_id'] ? 'Privilégier' : 'Conserver' %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table></div>
        <% elsif payload['field'] %>
          <div class="row g-3">
            <div class="col-md-6"><strong>Valeur actuelle</strong><p class="text-muted"><%= workbench_value(payload['field'], payload['before']) %></p></div>
            <div class="col-md-6"><strong>Valeur proposée</strong><p><%= workbench_value(payload['field'], payload['value']) %></p></div>
          </div>
        <% elsif payload['season_titles'] %>
          <p>Seuls les titres du catalogue changent. Les noms des répertoires sur disque restent identiques.</p>
          <ul>
            <% payload['season_titles'].each do |id, change| %>
              <li><%= link_to change['before'], record_path(id) %> → <%= change['after'] %></li>
            <% end %>
          </ul>
        <% elsif payload['operations'] %>
          <%= render 'reconciliation_workbench/series_structure', payload: payload %>
        <% elsif payload['roles'] %>
          <p><%= payload['roles'].size %> fiches dont le rôle sera précisé ; <%= payload['file_count'] %> fichiers concernés. Les liens de parenté restent identiques.</p>
          <details><summary>Voir les rôles proposés</summary><ul class="mt-2">
            <% payload['roles'].each do |id, role| %>
              <li><%= payload.dig('records', id, 'attributes', 'french_title') %> → <%= { 'series' => 'série', 'season' => 'saison', 'episode' => 'épisode' }.fetch(role) %></li>
            <% end %>
          </ul></details>
        <% else %>
          <p class="text-break"><%= payload['path'] %></p>
          <p class="small text-muted">Le fichier sera rattaché à cette fiche, sans déplacement ni changement de nom.</p>
        <% end %>
        <% if payload['reason'] %><p><%= payload['reason'] %></p><% end %>
        <% Array(payload['sources']).each do |url| %>
          <p class="small mb-1 text-break"><%= link_to url, url, target: '_blank', rel: 'noopener noreferrer' %></p>
        <% end %>
        <% if item.error.present? %><p class="text-danger small mt-2 mb-0"><strong>Exception :</strong> <%= item.error %></p><% end %>
      </div>
    </article>
  <% end %>
  <nav class="d-flex gap-3 mb-4" aria-label="Pages des propositions">
    <% if @page > 1 %><%= link_to "Page précédente", reconciliation_workbench_family_path(@rule.key, page: @page - 1) %><% end %>
    <span>Page <%= @page %> · <%= @total %> propositions au total</span>
    <% if @page * 30 < @total %><%= link_to "Page suivante", reconciliation_workbench_family_path(@rule.key, page: @page + 1) %><% end %>
  </nav>
  <% if @rule.key == ReconciliationWorkbench::Rules::SOURCED_STRUCTURE.key %>
    <%= render 'reconciliation_workbench/structure_backlog' %>
  <% end %>
  <% if @rule.key == ReconciliationWorkbench::Rules::PREFERENCE.key %>
    <section class="card mb-3"><div class="card-body">
      <h2 class="h5">Confirmer les choix de cette page</h2>
      <p>Une confirmation pour tous les épisodes sélectionnés sur cette page. Les autres restent à examiner. Ces choix ne créent aucune règle automatique pour les futurs conflits et ne suppriment aucun fichier.</p>
      <%= form_with url: arbitrate_reconciliation_workbench_family_path(@rule.key), method: :post, id: 'copy-arbitration' do |form| %>
        <%= form.hidden_field :scope_digest, value: @scope_digest %>
        <%= form.hidden_field :page, value: @page %>
        <%= form.label :comment, "Justification commune (facultative)", class: 'form-label' %>
        <%= form.text_area :comment, rows: 2, class: 'form-control mb-3' %>
        <%= form.submit 'Confirmer les choix et lancer leur application', class: 'btn btn-primary', disabled: @total.zero? %>
      <% end %>
    </div></section>
  <% end %>
  <section class="card"><div class="card-body">
    <h2 class="h5">Validation de la règle de cette famille</h2>
    <% if @scope.where(status: 'blocked').exists? %>
      <p class="small text-muted">Pour réexaminer une fiche modifiée, diffère la famille puis actualise les propositions. Tu pourras examiner leur nouvel état avant une nouvelle validation.</p>
    <% end %>
    <%= form_with url: decision_reconciliation_workbench_family_path(@rule.key), method: :post do |form| %>
      <%= form.hidden_field :scope_digest, value: @scope_digest %>
      <%= form.label :comment, "Ton avis ou la règle à préciser", class: "form-label" %>
      <%= form.text_area :comment, value: @decision&.comment, rows: 2, class: "form-control mb-3" %>
      <div class="d-flex flex-wrap gap-2">
        <%= form.button "Valider et lancer les règles approuvées", name: 'decision', value: 'approved', disabled: @total.zero?, class: "btn btn-primary", data: { turbo_submits_with: 'Enregistrement de la validation…' } %>
        <%= form.button "À préciser", name: 'decision', value: 'deferred', class: "btn btn-outline-secondary" %>
        <%= form.button "Écarter cette règle", name: 'decision', value: 'rejected', class: "btn btn-outline-danger" %>
      </div>
      <p class="small text-muted mt-2 mb-0">Une validation sur cet axe n’approuve aucune règle de l’autre axe. Les règles déjà approuvées peuvent continuer à s’appliquer.</p>
    <% end %>
  </div></section>
</div>
