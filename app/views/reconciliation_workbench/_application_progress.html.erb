<% if progress.any? %>
  <% active, history = progress.partition { |entry| entry[:counts].values.sum.positive? } %>
  <section class="border rounded p-2 mt-2" aria-label="Suivi des familles validées">
    <h2 class="h5">Validations</h2>
    <% if active.any? %>
      <p class="small">Propositions autorisées en attente, en cours ou bloquées.</p>
      <% active.each do |entry| %>
        <%= render 'reconciliation_workbench/application_progress_entry', entry: entry %>
      <% end %>
    <% else %>
      <p class="small mb-1">Aucune proposition autorisée en attente, en cours ou bloquée.</p>
    <% end %>
    <% if history.any? %>
      <details data-application-history class="mt-2">
        <summary>Historique · <%= history.size %> familles validées</summary>
        <p class="small mt-2">Décisions et preuves conservées. Les règles récurrentes restent actives.</p>
        <% history.each do |entry| %>
          <%= render 'reconciliation_workbench/application_progress_entry', entry: entry %>
        <% end %>
      </details>
    <% end %>
  </section>
<% end %>
