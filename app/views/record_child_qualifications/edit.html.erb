<h1>Qualifier les enfants</h1>

<p data-child-qualification-parent>
  <strong>Parent :</strong>
  <%= link_to @record.complete_title, record_path(@record) %>
</p>

<% if @qualification&.errors&.any? %>
  <div
    class="alert alert-danger"
    data-child-qualification-errors
  >
    <ul class="mb-0">
      <% @qualification.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if @qualifiable_children.any? && @qualification_targets.any? %>
  <%= form_with(
    url: record_child_qualification_path(@record),
    method: :patch,
    scope: :record_child_qualification
  ) do %>
    <section>
      <h2>Nature à appliquer</h2>

      <label for="record_child_qualification_record_kind">
        Nature du contenu
      </label>

      <select
        id="record_child_qualification_record_kind"
        name="record_child_qualification[record_kind]"
      >
        <% @qualification_targets.each do |record_kind| %>
        <%= tag.option(
          record_kind_label(record_kind),
          value: record_kind,
          selected: @selected_record_kind == record_kind,
          data: {
            child_qualification_target: record_kind
          }
        ) %>
        <% end %>
      </select>
    </section>

    <section>
      <h2>Enfants à qualifier</h2>

      <ul>
        <% @qualifiable_children.each do |child| %>
          <% checkbox_id = "record_child_qualification_child_#{child.id}" %>
          <li data-qualifiable-child="<%= child.id %>">
            <%= check_box_tag(
              "record_child_qualification[child_ids][]",
              child.id,
              @selected_child_ids.include?(child.id.to_s),
              id: checkbox_id
            ) %>
            <%= label_tag checkbox_id, child.complete_title %>
          </li>
        <% end %>
      </ul>
    </section>

    <%= submit_tag(
      "Qualifier la sélection",
      class: "btn btn-primary",
      data: {
        turbo_confirm:
          "Qualifier les enfants sélectionnés avec la nature choisie ?"
      }
    ) %>
  <% end %>
<% elsif @qualifiable_children.empty? %>
  <p>Aucun enfant à qualifier.</p>
<% else %>
  <p data-child-qualification-unavailable>
    Aucune nature compatible ne peut être appliquée aux enfants de cette fiche.
  </p>
<% end %>

<section>
  <h2>Enfants déjà qualifiés, conservés sans modification</h2>

  <ul>
    <% @preserved_children.each do |child| %>
      <li data-preserved-child="<%= child.id %>">
        <%= link_to child.complete_title, record_path(child) %>
        — <%= record_kind_label(child.record_kind) %>
      </li>
    <% end %>
  </ul>
</section>

<%= link_to "Retour à la fiche", record_path(@record) %>
