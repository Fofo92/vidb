<h1>Enregistrements programmés</h1>
<p class="text-body-secondary">Une sélection doit être programmée dans Kaffeine pour être enregistrée.</p>
<p><%= link_to "Voir toutes les programmations Kaffeine", tv_kaffeine_schedules_path %></p>

<div data-controller="recording-intents-scroll" data-action="submit->recording-intents-scroll#remember">
<% if @recording_intents.empty? %>
  <p
    class="alert alert-info"
    data-recording-intents-empty>
    Aucun enregistrement n’est programmé.
  </p>
<% else %>
  <% @recording_intents_by_date.each do |date, recording_intents| %>
    <section
      class="mb-4"
      data-recording-day="<%= date.iso8601 %>">
      <h2 class="h4">
        <%= recording_intent_date_heading(date) %>
      </h2>

      <div class="table-responsive">
        <table class="table table-sm align-middle tv-recording-intents-table" data-recording-intents-table>
          <colgroup>
            <col class="tv-recording-intents-channel">
            <col class="tv-recording-intents-name">
            <col class="tv-recording-intents-programme">
            <col class="tv-recording-intents-capture">
          </colgroup>

          <thead>
            <tr>
              <th scope="col">Chaîne</th>
              <th scope="col">Nom</th>
              <th scope="col">Programme</th>
              <th scope="col">Capture</th>
            </tr>
          </thead>

          <tbody>
            <% recording_intents.each do |recording_intent| %>
              <tr data-recording-intent="<%= recording_intent.id %>">
                <td data-recording-channel>
                  <%= recording_intent_channel_name(recording_intent) %>
                </td>

                <td>
                  <strong data-recording-title>
                    <%= recording_intent_title(recording_intent) %>
                  </strong>
                </td>

                <td
                  class="text-nowrap"
                  data-programme-window>
                  <%= recording_intent_time(
                    recording_intent.programme_starts_at
                  ) %>
                  –
                  <%= recording_intent_time(
                    recording_intent.programme_ends_at
                  ) %>
                </td>

                <td>
                  <div
                    class="d-flex align-items-center justify-content-between gap-3">
                    <span class="text-body-secondary text-nowrap" data-capture-window>
                      <%= recording_intent_time(recording_intent.capture_starts_at) %>
                      –
                      <%= recording_intent_time(recording_intent.capture_ends_at) %>
                    </span>

                    <%= form_with(
                      url: tv_recording_intent_path(recording_intent),
                      method: :delete
                    ) do %>
                      <%= hidden_field_tag :return_to, "index" %>
                      <%= button_tag(
                        "Annuler",
                        type: "submit",
                        class: "btn btn-sm btn-outline-danger"
                      ) %>
                    <% end %>
                  </div>
                  <div class="mt-2" data-kaffeine-schedule>
                    <% if (link = recording_intent.kaffeine_schedule_link) %>
                      <span class="text-success">Programmée (n° <%= link.kaffeine_key %>)</span>
                      <% if link.name != recording_intent_title(recording_intent) %>
                        <small class="d-block text-body-secondary" data-kaffeine-name>
                          Nom Kaffeine à la liaison : <%= link.name %>
                        </small>
                      <% end %>
                      <% if recording_intent.recording_verified_at? %>
                        <span class="d-block text-success" data-recording-verified>
                          Fichier vérifié
                        </span>
                        <%= button_to "Retirer la confirmation",
                                      tv_recording_intent_recording_confirmation_path(recording_intent),
                                      method: :delete,
                                      class: "btn btn-sm btn-outline-secondary" %>
                      <% elsif recording_intent.recording_confirmable? %>
                        <%= button_to "J’ai vérifié le fichier",
                                      tv_recording_intent_recording_confirmation_path(recording_intent),
                                      class: "btn btn-sm btn-outline-success" %>
                      <% end %>
                    <% elsif recording_intent.broadcast_observation.guide_channel.channel&.kaffeine_name.present? %>
                      <%= form_with(
                        url: tv_recording_intent_schedule_path(recording_intent),
                        method: :post
                      ) do %>
                        <%= button_tag(
                          "Programmer dans Kaffeine",
                          type: "submit",
                          class: "btn btn-sm btn-outline-primary"
                        ) %>
                      <% end %>
                    <% else %>
                      <span class="text-body-secondary">Chaîne non reliée</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
<% end %>
</div>
